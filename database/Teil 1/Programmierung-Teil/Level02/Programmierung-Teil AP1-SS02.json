  "cards": [
    {
      "id": "card_001",
      "text": "Beschreibt aus Nutzersicht, was das System leisten soll, ohne Implementierungsdetails.",
      "correctForms": [
        "use_case_diagramm"
      ]
    },
    {
      "id": "card_002",
      "text": "Bindet verpflichtendes, wiederverwendbares Verhalten in einen Use Case ein.",
      "correctForms": [
        "include"
      ]
    },
    {
      "id": "card_003",
      "text": "Ergänzt einen Basis-Use-Case nur bei zusätzlicher Bedingung optional.",
      "correctForms": [
        "extend"
      ]
    },
    {
      "id": "card_004",
      "text": "Repräsentiert im Use Case eine Funktion/Rolle und keine konkrete Person.",
      "correctForms": [
        "actor_rolle"
      ]
    },
    {
      "id": "card_005",
      "text": "Grenzt im Diagramm ab, was intern ist und was als externes System gilt.",
      "correctForms": [
        "systemgrenze"
      ]
    },
    {
      "id": "card_006",
      "text": "Zeigt Entscheidungs- und Ablaufpfade mit klaren Bedingungen.",
      "correctForms": [
        "aktivitatsdiagramm"
      ]
    },
    {
      "id": "card_007",
      "text": "Visualisiert Nachrichten in zeitlicher Reihenfolge zwischen Lifelines.",
      "correctForms": [
        "sequenzdiagramm"
      ]
    },
    {
      "id": "card_008",
      "text": "Modelliert Objektlebensphasen wie 'neu', 'in Bearbeitung', 'geschlossen'.",
      "correctForms": [
        "zustandsdiagramm"
      ]
    },
    {
      "id": "card_009",
      "text": "Enthält Klassenname, Attribute, Methoden und Beziehungen.",
      "correctForms": [
        "klassendiagramm"
      ]
    },
    {
      "id": "card_010",
      "text": "Starke Teil-Ganzes-Beziehung mit gemeinsamem Lebenszyklus.",
      "correctForms": [
        "komposition"
      ]
    },
    {
      "id": "card_011",
      "text": "Allgemeine Beziehung zwischen Klassen ohne zwingende Lebenszyklusbindung.",
      "correctForms": [
        "assoziation"
      ]
    },
    {
      "id": "card_012",
      "text": "Datenmodell mit Entitäten, Attributen und Beziehungen als Basis für relationale Tabellen.",
      "correctForms": [
        "erd_erm"
      ]
    },
    {
      "id": "card_013",
      "text": "Eindeutige Identifikation eines Datensatzes innerhalb einer Tabelle.",
      "correctForms": [
        "primarschlussel"
      ]
    },
    {
      "id": "card_014",
      "text": "Referenziert einen Primärschlüssel einer anderen Tabelle.",
      "correctForms": [
        "fremdschlussel"
      ]
    },
    {
      "id": "card_015",
      "text": "Relationale Standardlösung, wenn eine Beziehung auf beiden Seiten viele Elemente hat.",
      "correctForms": [
        "m_n_zwischentabelle"
      ]
    },
    {
      "id": "card_016",
      "text": "Keine Listen oder Mehrfachwerte in einer einzelnen Tabellenzelle.",
      "correctForms": [
        "1nf"
      ]
    },
    {
      "id": "card_017",
      "text": "Bei zusammengesetztem Schlüssel: Nicht-Schlüsselattribute müssen vom gesamten Schlüssel abhängen.",
      "correctForms": [
        "2nf"
      ]
    },
    {
      "id": "card_018",
      "text": "Vermeidet transitive Abhängigkeiten zwischen Nicht-Schlüsselattributen.",
      "correctForms": [
        "3nf"
      ]
    },
    {
      "id": "card_019",
      "text": "Sprachneutrale, strukturierte Beschreibung eines Algorithmus.",
      "correctForms": [
        "pseudocode"
      ]
    },
    {
      "id": "card_020",
      "text": "Nutze ich, wenn ich standardisierte Diagramm-Symbole wie Raute/Rechteck brauche.",
      "correctForms": [
        "pap_flowchart"
      ]
    },
    {
      "id": "card_021",
      "text": "Blockstrukturierte Darstellungsform ohne Flusspfeile.",
      "correctForms": [
        "struktogramm"
      ]
    },
    {
      "id": "card_022",
      "text": "Testtechnik mit Werten direkt unter, auf und über einer Grenze.",
      "correctForms": [
        "grenzwertanalyse"
      ]
    },
    {
      "id": "card_023",
      "text": "Teilt Eingaben in sinnvolle Bereiche und testet je Bereich repräsentative Werte.",
      "correctForms": [
        "aquivalenzklasse"
      ]
    },
    {
      "id": "card_024",
      "text": "Prüft absichtlich ungültige oder unerwartete Eingaben.",
      "correctForms": [
        "negativtest"
      ]
    },
    {
      "id": "card_025",
      "text": "Testet einzelne Funktion/Methodik isoliert vom Gesamtsystem.",
      "correctForms": [
        "unit_test"
      ]
    },
    {
      "id": "card_026",
      "text": "Validiert das Zusammenspiel mehrerer Komponenten über Schnittstellen.",
      "correctForms": [
        "integrationstest"
      ]
    },
    {
      "id": "card_027",
      "text": "Prüft das Gesamtsystem aus Endanwendersicht Ende-zu-Ende.",
      "correctForms": [
        "systemtest"
      ]
    },
    {
      "id": "card_028",
      "text": "Strukturierte Protokollierung zur Nachvollziehbarkeit von Ereignissen/Fehlern.",
      "correctForms": [
        "logging"
      ]
    },
    {
      "id": "card_029",
      "text": "Prinzip: ein Modul sollte nur einen klaren Grund zur Änderung haben.",
      "correctForms": [
        "single_responsibility"
      ]
    },
    {
      "id": "card_030",
      "text": "Verbessert Lesbarkeit und Wartbarkeit durch fachlich klare Namensgebung.",
      "correctForms": [
        "sprechende_bezeichner"
      ]
    },
    {
      "id": "card_031",
      "text": "Schützt gegen fehlerhafte und gefährliche Daten bereits am Systemeingang.",
      "correctForms": [
        "input_validierung"
      ]
    },
    {
      "id": "card_032",
      "text": "Fehler nicht verschlucken, sondern kontrolliert behandeln und nachvollziehbar machen.",
      "correctForms": [
        "fehlerbehandlung"
      ]
    },
    {
      "id": "card_033",
      "text": "CREATE, ALTER, DROP gehören zu welchem SQL-Befehlstyp?",
      "correctForms": [
        "ddl"
      ]
    },
    {
      "id": "card_034",
      "text": "INSERT, UPDATE, DELETE gehören zu welchem SQL-Befehlstyp?",
      "correctForms": [
        "dml"
      ]
    },
    {
      "id": "card_035",
      "text": "SELECT gehört typischerweise zu welchem SQL-Befehlstyp?",
      "correctForms": [
        "dql"
      ]
    },
    {
      "id": "card_036",
      "text": "Filtert Datensätze vor GROUP BY und Aggregation.",
      "correctForms": [
        "where"
      ]
    },
    {
      "id": "card_037",
      "text": "Filtert bereits aggregierte Gruppen nach COUNT/SUM/AVG.",
      "correctForms": [
        "having"
      ]
    },
    {
      "id": "card_038",
      "text": "Bildet Gruppen als Grundlage für Aggregatfunktionen.",
      "correctForms": [
        "group_by"
      ]
    },
    {
      "id": "card_039",
      "text": "Verknüpft Tabellen über Schlüsselbeziehungen.",
      "correctForms": [
        "join"
      ]
    },
    {
      "id": "card_040",
      "text": "Entsteht oft unbeabsichtigt bei fehlender Join-Bedingung.",
      "correctForms": [
        "kartesisches_produkt"
      ]
    },
    {
      "id": "card_041",
      "text": "Lässt auch Zeilen der linken Tabelle ohne Treffer rechts im Ergebnis.",
      "correctForms": [
        "left_join"
      ]
    },
    {
      "id": "card_042",
      "text": "Mehrere Datenbankoperationen als unteilbare Einheit behandeln.",
      "correctForms": [
        "transaktion"
      ]
    },
    {
      "id": "card_043",
      "text": "Steht für Atomicity, Consistency, Isolation, Durability.",
      "correctForms": [
        "acid"
      ]
    },
    {
      "id": "card_044",
      "text": "Regelt, wie stark sich parallele Transaktionen gegenseitig sehen/beeinflussen.",
      "correctForms": [
        "isolation"
      ]
    },
    {
      "id": "card_045",
      "text": "Erkennt Schreibkonflikte über Versionsprüfung statt dauerhafter Sperren.",
      "correctForms": [
        "optimistisches_locking"
      ]
    },
    {
      "id": "card_046",
      "text": "Beschleunigt häufige Such- und Joinpfade, kann aber Schreibvorgänge verteuern.",
      "correctForms": [
        "index"
      ]
    },
    {
      "id": "card_047",
      "text": "Hilft zu analysieren, ob DB-Engine Scans, Indizes und Joinstrategie sinnvoll nutzt.",
      "correctForms": [
        "abfrageplan"
      ]
    },
    {
      "id": "card_048",
      "text": "Definiert stabil, welche Requests/Responses und Fehlercodes eine API liefern soll.",
      "correctForms": [
        "schnittstellenvertrag"
      ]
    },
    {
      "id": "card_049",
      "text": "Use Case, Aktivitätsdiagramm und ERD können je nach Fragestellung jeweils korrekt sein.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_050",
      "text": "'HAVING ersetzt WHERE in jeder SQL-Abfrage vollständig'",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
