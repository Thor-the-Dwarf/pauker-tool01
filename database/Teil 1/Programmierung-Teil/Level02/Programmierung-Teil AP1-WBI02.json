  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Ist es primär eine visuelle Diagrammform?",
      "attributeKey": "is_visual_diagram"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Beantwortet es vor allem die Frage, was fachlich gefordert ist?",
      "attributeKey": "answers_what_requirements"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Modelliert es Klassen mit Attributen/Methoden und Beziehungen?",
      "attributeKey": "models_classes_structure"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Geht es um Ablauf- bzw. Workflowlogik mit Verzweigungen?",
      "attributeKey": "models_workflow_logic"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Zeigt es Nachrichten/Interaktionen in zeitlicher Reihenfolge?",
      "attributeKey": "shows_message_sequence"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Beschreibt es Zustände und Zustandsübergänge?",
      "attributeKey": "shows_states_transitions"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Hat es einen klaren Bezug zu Datenmodellen/Schemafragen?",
      "attributeKey": "models_database_schema"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Wird es vor allem textuell als Regel-/Logikbeschreibung ausgedrückt?",
      "attributeKey": "describes_algorithm_textually"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Nutzt es explizit klassische Flowchart-Symbole?",
      "attributeKey": "uses_flowchart_symbols"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Arbeitet es blockstrukturiert statt pfeilbasiert?",
      "attributeKey": "uses_block_structure"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Betrifft es typische SQL-Basics wie SELECT/WHERE?",
      "attributeKey": "sql_basic_select_where"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Geht es um Tabellenverknüpfungen (JOIN)?",
      "attributeKey": "sql_joins_tables"
    },
    {
      "id": "q13",
      "hotkey": "13",
      "text": "Spielt Gruppierung/Aggregation (GROUP BY/HAVING) eine Kernrolle?",
      "attributeKey": "sql_group_by_aggregation"
    },
    {
      "id": "q14",
      "hotkey": "14",
      "text": "Liegt der Schwerpunkt auf Konsistenz-, Integritäts- oder Robustheitsregeln?",
      "attributeKey": "focuses_on_db_consistency_rules"
    },
    {
      "id": "q15",
      "hotkey": "15",
      "text": "Würde man es typischerweise bei ACID-/Transaktionsdiskussionen nennen?",
      "attributeKey": "focuses_on_db_consistency_rules"
    },
    {
      "id": "q16",
      "hotkey": "16",
      "text": "Ist es für AP1 eher ein Werkzeug zur Strukturierung als reiner Code?",
      "attributeKey": "is_visual_diagram"
    },
    {
      "id": "q17",
      "hotkey": "17",
      "text": "Hilft es direkt bei Auswahl der korrekten SQL-Filterstrategie?",
      "attributeKey": "sql_basic_select_where"
    },
    {
      "id": "q18",
      "hotkey": "18",
      "text": "Ist es relevant, wenn Race Conditions oder Konfliktupdates betrachtet werden?",
      "attributeKey": "focuses_on_db_consistency_rules"
    },
    {
      "id": "q19",
      "hotkey": "19",
      "text": "Hat es primär etwas mit Datenbanktabellen und deren Verhalten zu tun?",
      "attributeKey": "models_database_schema"
    },
    {
      "id": "q20",
      "hotkey": "20",
      "text": "Wird es typischerweise in Testdesign- oder Qualitätssicherungsantworten verwendet?",
      "attributeKey": "describes_algorithm_textually"
    }
  ],
