  "cards": [
    {
      "id": "card_001",
      "text": "Rechenwerk des PCs: Führt Befehle aus und bestimmt mit Kernen/Threads, Takt und Cache maßgeblich die Rechenleistung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Viele Kerne/Threads helfen besonders bei parallelen Aufgaben (z. B. Rendering), weniger bei rein single-thread-lastigen Jobs.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Kleiner, sehr schneller Zwischenspeicher direkt an/auf der CPU, reduziert Zugriffe auf den langsameren RAM.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Arbeitsspeicher: Flüchtig, schnell, hält aktuell genutzte Programme/Daten – wird beim Ausschalten gelöscht.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Dual-Channel: Zwei passende RAM-Module können den Datendurchsatz erhöhen (richtige Slots beachten).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Mehr RAM hilft vor allem gegen Auslagerung auf Massenspeicher, wenn viele Programme/Browser-Tabs offen sind.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Massenspeicher: Nicht-flüchtig, speichert OS/Programme/Daten dauerhaft (z. B. SSD oder HDD).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "NVMe-SSD nutzt typischerweise PCIe und ist meist deutlich schneller als SATA-SSD, vor allem bei vielen parallelen Zugriffen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "IOPS beschreibt, wie viele Ein-/Ausgabe-Operationen pro Sekunde möglich sind (wichtig bei vielen kleinen Dateien/DB).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "HDD: Mechanisch, günstig pro GB, gut für große Archive – aber langsamer und empfindlicher als SSD.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Mainboard: Verbindet alle Komponenten; bestimmt u. a. Sockel, RAM-Typ, PCIe-Slots, M.2, USB und Anschlüsse.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "Chipsatz: Steuert/koordiniert viele Board-Funktionen (I/O), beeinflusst z. B. Anzahl/Art von Ports und Erweiterbarkeit.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Formfaktor (z. B. ATX, mATX, ITX) muss zum Gehäuse passen und beeinflusst Anzahl Slots/Ports.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "M.2 ist ein Steckplatz-Formfaktor; darüber kann SATA- oder NVMe-SSD laufen (nicht automatisch immer NVMe).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "PCIe-Lanes sind begrenzt: Viele schnelle Geräte teilen sich ggf. Bandbreite oder Slots laufen nicht mit voller Anbindung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_016",
      "text": "Netzwerk: LAN ist kabelgebunden, meist stabiler und mit niedrigerer Latenz als WLAN.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_017",
      "text": "WLAN teilt sich Airtime: Viele Clients oder Störungen können die effektive Datenrate spürbar senken.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_018",
      "text": "Switch verbindet Geräte im gleichen Netzwerk (Layer 2) und verteilt Frames anhand MAC-Adressen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_019",
      "text": "Router verbindet unterschiedliche Netzwerke (z. B. LAN ↔ Internet) und übernimmt typischerweise Routing/NAT.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_020",
      "text": "Prüfungsfalle: Ein Switch ersetzt keinen Router, wenn du ins Internet oder in ein anderes Subnetz musst.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_021",
      "text": "Der Hardware-Grundbaukasten umfasst CPU, RAM, Massenspeicher, Mainboard/Chipsatz und Netzwerk – das sind die Kernblöcke im Überblick.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_022",
      "text": "„RAM ist ein dauerhafter Massenspeicher wie eine SSD und behält Daten nach dem Ausschalten.“",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
