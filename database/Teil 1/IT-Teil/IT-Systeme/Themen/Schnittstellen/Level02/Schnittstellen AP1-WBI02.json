    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Geht es primär um externe Ports und deren Fähigkeiten?",
      "attributeKey": "is_external_focus"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Spielt die Verteilung von PCIe-Lanes (x16/x8/x4, Sharing) die Hauptrolle?",
      "attributeKey": "concerns_pcie_lanes"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Geht es um M.2-Protokollfragen wie NVMe vs SATA?",
