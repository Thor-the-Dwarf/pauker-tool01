    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Ist ein Blick in Handbuch/Datenblatt typischerweise notwendig?",
      "attributeKey": "requires_handbook_check"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Handelt es sich um eine klassische AP1-Stolperfalle?",
      "attributeKey": "is_common_exam_trap"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Kann ungeeignete Kabelqualität das Problem verursachen oder verstärken?",
      "attributeKey": "depends_on_cable_quality"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Spielen Treiber-, Firmware- oder UEFI-Stände eine zentrale Rolle?",
