    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Ist USB-C mit unterschiedlichen Daten-/Lade-/Video-Profilen der Kern?",
      "attributeKey": "concerns_usb_c"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Stehen Bildausgabe-Themen wie DP/HDMI/EDID im Fokus?",
      "attributeKey": "concerns_video_output"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Dreht es sich um die ausgehandelte LAN-Linkrate zwischen zwei Enden?",
