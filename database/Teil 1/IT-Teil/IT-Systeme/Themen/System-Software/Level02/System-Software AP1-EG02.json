    {
      "id": "deep-quiz-l2",
      "type": "quiz",
      "title": "Rätsel 3: System-Software auf Prüfungsniveau",
      "subtitle": "Wähle die technisch beste Aussage.",
      "hintDefault": "Achte auf Schichtgrenzen und Abhängigkeiten statt auf Einzelbegriffe.",
      "questions": [
        {
          "id": "q1",
          "text": "1. Welche Aussage zu Kernel und Treibern ist korrekt?",
          "options": [
            { "value": "a", "text": "Treiber sind normale Fachanwendungen und beeinflussen Kernel-Stabilität nicht." },
            { "value": "b", "text": "Treiber arbeiten systemnah; fehlerhafte Treiber können Stabilität des gesamten Systems beeinträchtigen." },
            { "value": "c", "text": "Kernel verwaltet nur Fensterdarstellung, nicht Ressourcen." }
          ],
          "correct": "b"
        },
        {
          "id": "q2",
          "text": "2. Was beschreibt Runtime/Middleware im AP1-Kontext am besten?",
          "options": [
            { "value": "a", "text": "Physische Startlogik im UEFI-Chip." },
            { "value": "b", "text": "Zwischenschicht, die standardisierte Laufzeitfunktionen für Anwendungen bereitstellt." },
            { "value": "c", "text": "Ersatz für Betriebssystem und Treiber." }
          ],
          "correct": "b"
        },
        {
          "id": "q3",
          "text": "3. Welche Diagnose ist bei \"App startet nicht\" methodisch zuerst sinnvoll?",
          "options": [
            { "value": "a", "text": "Runtime-/Abhängigkeitsprüfung und Loganalyse der Anwendung." },
            { "value": "b", "text": "Direkt Firmware flashen ohne Befund." },
            { "value": "c", "text": "Nur Monitorauflösung ändern." }
          ],
          "correct": "a"
        },
        {
          "id": "q4",
          "text": "4. Welche Aussage zur Bootkette ist richtig?",
          "options": [
            { "value": "a", "text": "Anwendungen laden den Bootmanager." },
            { "value": "b", "text": "Firmware initialisiert Hardware und startet den Weg zum OS über den Bootmanager." },
            { "value": "c", "text": "Runtime ersetzt den Bootloader." }
          ],
          "correct": "b"
        }
      ]
    },
