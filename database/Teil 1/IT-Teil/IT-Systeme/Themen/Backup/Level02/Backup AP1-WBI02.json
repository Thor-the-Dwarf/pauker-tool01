  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Beschreibt es das grundsätzliche Ziel von Backups?",
      "attributeKey": "is_backup_goal"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Ist es eine strategische Regel oder ein Rahmenprinzip?",
      "attributeKey": "is_strategy_rule"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Ist es eine konkrete Backup-Art (voll/inkrementell/differenziell)?",
      "attributeKey": "is_backup_type"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Hat es direkten Einfluss auf schnelle Wiederanlaufziele (RTO)?",
      "attributeKey": "focuses_rto"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Hat es direkten Einfluss auf Datenverlustziele (RPO)?",
      "attributeKey": "focuses_rpo"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Erhöht es speziell Resilienz gegen Ransomware-Kompromittierung?",
      "attributeKey": "improves_ransomware_resilience"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Benötigt es Offsite- oder Isolationsgedanken als Kernbestandteil?",
      "attributeKey": "requires_offsite_or_isolation"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Unterstützt es schnellen Restore unmittelbar?",
      "attributeKey": "supports_fast_restore"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Ist die Restore-Kette potenziell komplex/anfällig?",
      "attributeKey": "restore_chain_complexity_high"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Sind regelmäßige Restore-Tests besonders relevant?",
      "attributeKey": "requires_regular_restore_tests"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Geht es stark um Speichereffizienz/Kostenoptimierung?",
      "attributeKey": "optimizes_storage_efficiency"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Ist es klar Teil von Disaster-Recovery-Überlegungen?",
      "attributeKey": "part_of_disaster_recovery"
    }
  ],
