  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Liegt der Schwerpunkt auf Leistung eines einzelnen Kerns?",
      "attributeKey": "focus_cpu_single_core"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Liegt der Schwerpunkt auf paralleler Kern-/Thread-Auslastung?",
      "attributeKey": "focus_cpu_multi_core"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Passt es typischerweise zu UI/Office-Reaktionsproblemen?",
      "attributeKey": "typical_for_ui_office"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Passt es typischerweise zu stark parallelisierbaren Jobs?",
      "attributeKey": "typical_for_parallel_jobs"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Deutet es auf RAM-Druck als zentrales Problem hin?",
      "attributeKey": "indicates_ram_pressure"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Ist es primär ein Thema der Speicherbandbreite?",
      "attributeKey": "is_memory_bandwidth_topic"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Ist es primär ein Thema der Speicherlatenz?",
      "attributeKey": "is_memory_latency_topic"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Spielt Kompatibilität/Plattformabgleich eine zentrale Rolle?",
      "attributeKey": "is_compatibility_topic"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Steht Zuverlässigkeit/Stabilität klar im Vordergrund?",
      "attributeKey": "is_reliability_topic"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Erfordert es explizite Unterstützung durch Plattform/Topologie?",
      "attributeKey": "requires_platform_support"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Wird es typischerweise besser mit mehr CPU-Kernen?",
      "attributeKey": "benefits_from_more_cores"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Wird es typischerweise besser mit mehr RAM-Kapazität?",
      "attributeKey": "benefits_from_more_ram"
    },
    {
      "id": "q13",
      "hotkey": "13",
      "text": "Sollte es nach Änderung unbedingt stabilitätstechnisch getestet werden?",
      "attributeKey": "needs_stability_validation"
    },
    {
      "id": "q14",
      "hotkey": "14",
      "text": "Hängt es eng mit Auslagerung/Paging zusammen?",
      "attributeKey": "related_to_swap_paging"
    },
    {
      "id": "q15",
      "hotkey": "15",
      "text": "Hat es häufig Relevanz im Virtualisierungs-/Serverkontext?",
      "attributeKey": "related_to_virtualization_server"
    }
  ],
