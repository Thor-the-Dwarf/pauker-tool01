  "cards": [
    {
      "id": "card_001",
      "text": "Relevanter Faktor bei kurzen seriellen UI-Aktionen.",
      "correctForms": [
        "single_core_leistung"
      ]
    },
    {
      "id": "card_002",
      "text": "Relevanter Faktor bei stark parallelisierbaren Builds/Renderjobs.",
      "correctForms": [
        "multi_core_leistung"
      ]
    },
    {
      "id": "card_003",
      "text": "Erklärt, warum ein serieller Restanteil die Skalierung mit mehr Kernen begrenzt.",
      "correctForms": [
        "amdahl_prinzip"
      ]
    },
    {
      "id": "card_004",
      "text": "Viele Threads warten auf dieselbe Sperre und bremsen sich gegenseitig.",
      "correctForms": [
        "thread_contention"
      ]
    },
    {
      "id": "card_005",
      "text": "Reduziert langsame Hauptspeicherzugriffe bei guter Datenlokalität.",
      "correctForms": [
        "cpu_cache"
      ]
    },
    {
      "id": "card_006",
      "text": "CPU senkt Takt bei Temperatur-/Leistungsgrenzen unter Dauerlast.",
      "correctForms": [
        "thermal_throttling"
      ]
    },
    {
      "id": "card_007",
      "text": "Primärer Hebel gegen Auslagerung bei vielen gleichzeitig offenen Anwendungen.",
      "correctForms": [
        "ram_kapazitat"
      ]
    },
    {
      "id": "card_008",
      "text": "Auslagerung von Speicherseiten auf Massenspeicher bei RAM-Druck.",
      "correctForms": [
        "paging_swap"
      ]
    },
    {
      "id": "card_009",
      "text": "Metrik, die bei Speicherengpässen oft deutlich ansteigt.",
      "correctForms": [
        "pagefault_rate"
      ]
    },
    {
      "id": "card_010",
      "text": "Wichtig bei iGPU und speicherintensiven Lasten mit hohem Datendurchsatz.",
      "correctForms": [
        "ram_bandbreite"
      ]
    },
    {
      "id": "card_011",
      "text": "Beschreibt, wie schnell einzelne Speicherzugriffe beantwortet werden.",
      "correctForms": [
        "ram_latenz"
      ]
    },
    {
      "id": "card_012",
      "text": "Zwei passende RAM-Module erhöhen die Speicherkanalbandbreite.",
      "correctForms": [
        "dual_channel"
      ]
    },
    {
      "id": "card_013",
      "text": "RAM-Profil, das spezifizierten Takt/Timings aktivieren kann.",
      "correctForms": [
        "xmp_expo"
      ]
    },
    {
      "id": "card_014",
      "text": "Kompatibilitätsliste für getestete RAM-Kits auf einem Mainboard.",
      "correctForms": [
        "qvl_kompatibilitat"
      ]
    },
    {
      "id": "card_015",
      "text": "Arbeitsspeicher mit Fehlererkennung/-korrektur für höhere Zuverlässigkeit.",
      "correctForms": [
        "ecc_ram"
      ]
    },
    {
      "id": "card_016",
      "text": "Notwendige Plattformvoraussetzung, damit ECC-Funktion wirklich aktiv ist.",
      "correctForms": [
        "ecc_plattformsupport"
      ]
    },
    {
      "id": "card_017",
      "text": "Validiert RAM-Stabilität nach Profilwechsel oder Overclocking.",
      "correctForms": [
        "memtest_stabilitatstest"
      ]
    },
    {
      "id": "card_018",
      "text": "Gemeinsame Bewertung von CPU-, RAM- und I/O-Messbild.",
      "correctForms": [
        "bottleneck_analyse"
      ]
    },
    {
      "id": "card_019",
      "text": "Messung -> Engpass -> Maßnahme statt Hardwaretausch auf Verdacht.",
      "correctForms": [
        "upgrade_reihenfolge"
      ]
    },
    {
      "id": "card_020",
      "text": "Leistung nicht nur über Takt, sondern auch über Architektur-Effizienz erklären.",
      "correctForms": [
        "ipc_vs_ghz"
      ]
    },
    {
      "id": "card_021",
      "text": "Mehr logische Threads pro Kern, aber kein Ersatz für zusätzliche physische Kerne.",
      "correctForms": [
        "smt_hyper_threading"
      ]
    },
    {
      "id": "card_022",
      "text": "Speicherzugriff auf lokalem Knoten kann in Mehrsockelsystemen Leistung verbessern.",
      "correctForms": [
        "numa_lokalitat"
      ]
    },
    {
      "id": "card_023",
      "text": "Zu aggressive VM-RAM-Überbuchung kann in Ballooning/Swap kippen.",
      "correctForms": [
        "memory_overcommit"
      ]
    },
    {
      "id": "card_024",
      "text": "Lastklasse, bei der Antwortzeit wichtiger als maximaler Gesamtdurchsatz ist.",
      "correctForms": [
        "latenzsensitive_last"
      ]
    },
    {
      "id": "card_025",
      "text": "Lastklasse, bei der Gesamtarbeit pro Zeiteinheit im Vordergrund steht.",
      "correctForms": [
        "durchsatzlast"
      ]
    },
    {
      "id": "card_026",
      "text": "Grenzt Sustained-Leistung bei langen CPU-Lastphasen ein.",
      "correctForms": [
        "power_limit"
      ]
    },
    {
      "id": "card_027",
      "text": "Messmethode, um echte Hotspots statt Vermutungen zu finden.",
      "correctForms": [
        "profiling"
      ]
    },
    {
      "id": "card_028",
      "text": "Ressourcen so dimensionieren, dass Lastspitzen ohne Swap und Instabilität laufen.",
      "correctForms": [
        "kapazitatsplanung"
      ]
    },
    {
      "id": "card_029",
      "text": "Betriebsprinzip: lieber reproduzierbar stabil als nur kurzfristig benchmarkstark.",
      "correctForms": [
        "stabilitat_vor_peak"
      ]
    },
    {
      "id": "card_030",
      "text": "CPU/RAM-Optimierung ist direkt kein Begriff aus Backup-RTO/RPO-Planung.",
      "correctForms": [
        "rto_rpo_unabhangig"
      ]
    },
    {
      "id": "card_031",
      "text": "Bei 100% einem Thread und niedriger Gesamtlast ist meist Single-Thread-Limit relevant.",
      "correctForms": [
        "single_core_leistung"
      ]
    },
    {
      "id": "card_032",
      "text": "Bei voller Kernlast in Renderjobs ist meist Multi-Core-Durchsatz der primäre Hebel.",
      "correctForms": [
        "multi_core_leistung"
      ]
    },
    {
      "id": "card_033",
      "text": "Wenn RAM 99% und Datenträger dauerhaft aktiv ist, liegt oft Speicherengpass vor.",
      "correctForms": [
        "paging_swap"
      ]
    },
    {
      "id": "card_034",
      "text": "Niedrigeres CL allein beweist nicht automatisch niedrigere echte Zugriffszeit.",
      "correctForms": [
        "ram_latenz"
      ]
    },
    {
      "id": "card_035",
      "text": "1x16 GB vs 2x8 GB kann besonders bei iGPU deutliche Unterschiede zeigen.",
      "correctForms": [
        "dual_channel"
      ]
    },
    {
      "id": "card_036",
      "text": "ECC, Memtest und Kompatibilitätsprüfung dienen gemeinsam der Stabilität.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_037",
      "text": "'Mehr Kerne lösen jeden Leistungsengpass unabhängig vom Messbild.'",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_038",
      "text": "'XMP aktivieren ersetzt jede Stabilitätsprüfung nach RAM-Änderung.'",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_039",
      "text": "Ein gutes Tuning berücksichtigt Messung, Workload und Plattformgrenzen gemeinsam.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_040",
      "text": "Steigende Pagefaults und hohe Auslagerung trotz moderater CPU weisen auf RAM-Thema.",
      "correctForms": [
        "pagefault_rate"
      ]
    },
    {
      "id": "card_041",
      "text": "Wenn Leistungsabfall erst nach Minuten Dauerlast auftritt, zuerst Kühlung/Power-Limits prüfen.",
      "correctForms": [
        "thermal_throttling"
      ]
    },
    {
      "id": "card_042",
      "text": "Bezeichnet die Komponente, die aktuell den Gesamtdurchsatz am stärksten limitiert.",
      "correctForms": [
        "bottleneck_analyse"
      ]
    }
  ]
}
