        {
          "id": "f2",
          "text": "2. Render-Node: alle Kerne konstant voll, RAM moderat, kaum Paging. Wahrscheinlichster Upgrade-Hebel?",
          "options": [
            { "value": "a", "text": "Mehr Kerne/Threads bzw. höherer Multi-Core-Durchsatz" },
            { "value": "b", "text": "Nur ECC aktivieren" },
            { "value": "c", "text": "Swap-Datei vergrößern" }
