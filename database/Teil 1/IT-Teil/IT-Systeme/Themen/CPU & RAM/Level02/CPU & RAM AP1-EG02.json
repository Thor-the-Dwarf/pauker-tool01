    {
      "id": "ecc-quiz-l2",
      "type": "quiz",
      "title": "Rätsel 6: ECC und Betriebssicherheit",
      "subtitle": "Server-nahe Prüfungsfragen präzise beantworten.",
      "hintDefault": "ECC erhöht Integrität und Stabilität, nicht primär rohe Geschwindigkeit.",
      "questions": [
        {
          "id": "e1",
          "text": "1. Welche Aussage zu ECC ist korrekt?",
          "options": [
            { "value": "a", "text": "ECC ist primär für maximale Gaming-FPS gedacht." },
            { "value": "b", "text": "ECC reduziert Risiko stiller Speicherfehler in kritischen Systemen." },
            { "value": "c", "text": "ECC funktioniert unabhängig von Plattform-Support." }
          ],
          "correct": "b"
        },
        {
          "id": "e2",
          "text": "2. Warum ist ECC bei Datenbanken/Hypervisoren relevant?",
          "options": [
            { "value": "a", "text": "Weil es RAM-Kapazität verdoppelt" },
            { "value": "b", "text": "Weil Speicherfehler sonst zu Korruption/Instabilität führen können" },
            { "value": "c", "text": "Weil ECC den SSD-Controller ersetzt" }
          ],
          "correct": "b"
        },
        {
          "id": "e3",
          "text": "3. Was ist ein häufiger Denkfehler?",
          "options": [
            { "value": "a", "text": "ECC und Kompatibilitätsprüfung gehören zusammen" },
            { "value": "b", "text": "ECC-Module einstecken reicht immer, Plattform ist egal" },
            { "value": "c", "text": "ECC ist eher Zuverlässigkeits- als Performance-Thema" }
          ],
          "correct": "b"
        }
      ]
    },
