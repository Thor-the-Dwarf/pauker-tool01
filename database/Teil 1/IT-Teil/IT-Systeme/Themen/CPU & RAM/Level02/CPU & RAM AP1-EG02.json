    {
      "id": "diagnose-quiz-l2",
      "type": "quiz",
      "title": "Rätsel 2: Bottleneck-Diagnose",
      "subtitle": "Wähle die fachlich sauberste Interpretation der Messwerte.",
      "hintDefault": "CPU-Auslastung allein ist unzuverlässig. Immer RAM, Pagefaults und I/O mitbewerten.",
      "questions": [
        {
          "id": "d1",
          "text": "1. CPU gesamt 35%, RAM 98%, Pagefile-Aktivität hoch. Wahrscheinlichste Ursache?",
          "options": [
            { "value": "a", "text": "Zu wenige CPU-Kerne" },
            { "value": "b", "text": "RAM-Druck mit Paging/Swap" },
            { "value": "c", "text": "Defekter CPU-Cache" }
          ],
          "correct": "b"
        },
        {
          "id": "d2",
          "text": "2. Ein Thread läuft dauerhaft 100%, alle anderen niedrig. Beste Maßnahme zuerst?",
          "options": [
            { "value": "a", "text": "Mehr RAM einbauen" },
            { "value": "b", "text": "Single-Core/Codepfad optimieren oder parallelisieren" },
            { "value": "c", "text": "Swap-Datei vergrößern" }
          ],
          "correct": "b"
        },
        {
          "id": "d3",
          "text": "3. Welcher Satz ist AP1-sauber?",
          "options": [
            { "value": "a", "text": "Mehr Kerne sind immer wichtiger als RAM-Kapazität." },
            { "value": "b", "text": "Der richtige Flaschenhals hängt vom Workload und Messbild ab." },
            { "value": "c", "text": "RAM-Latenz ist nur Marketing und nie relevant." }
          ],
          "correct": "b"
        },
        {
          "id": "d4",
          "text": "4. Warum kann ein PC trotz NVMe bei RAM-Mangel stark bremsen?",
          "options": [
            { "value": "a", "text": "Weil NVMe langsamer als HDD ist" },
            { "value": "b", "text": "Weil auch NVMe-Latenzen im Vergleich zu RAM sehr hoch sind" },
            { "value": "c", "text": "Weil Windows bei NVMe keine Auslagerung erlaubt" }
          ],
          "correct": "b"
        }
      ]
    },
    {
      "id": "ram-formel-quiz",
      "type": "quiz",
      "title": "Rätsel 3: RAM-Timing wirklich verstehen",
      "subtitle": "Bewerte Takt/CL nicht isoliert.",
      "hintDefault": "Effektive CAS-Latenz in ns grob: CL / (Datenrate/2) * 1000.",
      "questions": [
        {
          "id": "r1",
          "text": "1. Was ist die korrekte AP1-Aussage?",
          "options": [
            { "value": "a", "text": "Niedrigeres CL ist immer schneller, egal bei welchem Takt." },
            { "value": "b", "text": "CL muss gemeinsam mit Takt betrachtet werden, um echte Latenz zu bewerten." },
            { "value": "c", "text": "RAM-Takt hat nur bei Servern Einfluss." }
          ],
          "correct": "b"
        },
        {
          "id": "r2",
          "text": "2. Welche Konfiguration ist für Speicherbandbreite typischerweise besser?",
          "options": [
            { "value": "a", "text": "1x16 GB Single-Channel" },
            { "value": "b", "text": "2x8 GB Dual-Channel" },
            { "value": "c", "text": "Beides ist immer identisch" }
          ],
          "correct": "b"
        },
        {
          "id": "r3",
          "text": "3. Was bringt RAM-OC ohne Stabilitätstest?",
          "options": [
            { "value": "a", "text": "Sicher immer mehr Leistung ohne Risiko" },
            { "value": "b", "text": "Kann instabil sein; Validierung mit Memtests ist Pflicht" },
            { "value": "c", "text": "Hat nur Einfluss auf SSD-Leistung" }
          ],
          "correct": "b"
        }
      ]
    },
