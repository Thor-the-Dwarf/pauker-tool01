      "title": "Rätsel 1: Workload korrekt klassifizieren",
      "subtitle": "Ordne jede Situation nach dominantem Leistungsfaktor.",
      "hintDefault": "Nicht nur CPU-Kerne betrachten: oft entscheiden RAM-Druck und I/O-Muster.",
      "sortColumns": [
        { "zone": "single", "label": "Single-Core dominiert", "hint": "kurze serielle Last" },
        { "zone": "multi", "label": "Multi-Core dominiert", "hint": "parallelisierbar" },
        { "zone": "memory", "label": "RAM/Bandbreite dominiert", "hint": "Speicherengpass" }
      ],
      "sortCards": [
        { "id": "w1", "text": "ERP-Maske reagiert träge trotz niedriger Gesamt-CPU-Last", "correctZone": "single" },
        { "id": "w2", "text": "Paralleles Video-Encoding auf mehreren Streams", "correctZone": "multi" },
        { "id": "w3", "text": "Viele VMs verursachen hohe Pagefault-Rate", "correctZone": "memory" },
        { "id": "w4", "text": "Großer Build nutzt alle Threads konstant >90%", "correctZone": "multi" },
        { "id": "w5", "text": "Browser mit 80 Tabs und IDE: ständiges Nachladen", "correctZone": "memory" },
        { "id": "w6", "text": "Single-Thread-Skript blockiert kompletten Batch", "correctZone": "single" },
        { "id": "w7", "text": "iGPU-Gaming profitiert stark von schnellerem Dual-Channel-RAM", "correctZone": "memory" },
        { "id": "w8", "text": "Kurze UI-Aktionen fühlen sich trotz vieler Kerne verzögert an", "correctZone": "single" }
      ]
