    {
      "id": "finops-quiz-l2",
      "type": "quiz",
      "title": "Raetsel 5: FinOps und Kostensteuerung",
      "subtitle": "Bewerte Massnahmen gegen cloudtypische Kostenfallen.",
      "hintDefault": "Ohne Tagging, Budgets und Rightsizing verliert man schnell die Kostenkontrolle.",
      "questions": [
        {
          "id": "f1",
          "text": "1. Welche Massnahme ist am wirksamsten gegen vergessene Testinstanzen?",
          "options": [
            { "value": "a", "text": "Auto-Shutdown ausserhalb Arbeitszeit plus Owner-Tagging" },
            { "value": "b", "text": "Mehr CPU buchen" },
            { "value": "c", "text": "Alle Alarme deaktivieren" }
          ],
          "correct": "a"
        },
        {
          "id": "f2",
          "text": "2. Was ist der zentrale Nutzen von Kosten-Tagging?",
          "options": [
            { "value": "a", "text": "Es verschluesselt Daten automatisch" },
            { "value": "b", "text": "Kosten lassen sich Teams/Projekten zuordnen und steuern" },
            { "value": "c", "text": "Es ersetzt jede Sicherheitsmassnahme" }
          ],
          "correct": "b"
        },
        {
          "id": "f3",
          "text": "3. Welche Aussage ist fachlich korrekt?",
          "options": [
            { "value": "a", "text": "Cloud ist immer billiger als On-Prem" },
            { "value": "b", "text": "Cloud kann wirtschaftlich sein, braucht aber aktives Kostenmanagement" },
            { "value": "c", "text": "FinOps ist nur fuer Grosskonzerne relevant" }
          ],
          "correct": "b"
        }
      ]
    },
    {
      "id": "resilience-sort-l2",
      "type": "sort",
      "title": "Raetsel 6: Verfuegbarkeit und DR",
      "subtitle": "Ordne Massnahmen nach Ziel: Verfuegbarkeit, Recovery oder beides.",
      "hintDefault": "Multi-AZ reduziert Ausfallrisiko. DR-Plan mit RTO/RPO adressiert Wiederanlauf.",
      "sortColumns": [
        { "zone": "avail", "label": "Verfuegbarkeit", "hint": "laufender Betrieb" },
        { "zone": "recovery", "label": "Recovery/DR", "hint": "Wiederanlauf" },
        { "zone": "both", "label": "Beides", "hint": "kombinierte Wirkung" }
      ],
      "sortCards": [
        { "id": "rs1", "text": "Applikation ueber zwei Availability Zones verteilen", "correctZone": "avail" },
        { "id": "rs2", "text": "Regelmaessiger Restore-Test fuer kritische Daten", "correctZone": "recovery" },
        { "id": "rs3", "text": "RTO/RPO pro Dienst definieren und ueberwachen", "correctZone": "recovery" },
        { "id": "rs4", "text": "Load-Balancer mit Health-Checks", "correctZone": "avail" },
        { "id": "rs5", "text": "Multi-Region-Failover-Runbook", "correctZone": "both" },
        { "id": "rs6", "text": "Backup plus geo-redundante Replikation", "correctZone": "both" }
      ]
    },
    {
      "id": "finale-quiz-l2",
      "type": "quiz",
      "title": "Finale: AP1-Cloud-Entscheidung",
      "subtitle": "Waehle die robusteste Gesamtbewertung.",
      "hintDefault": "Cloud-Entscheidungen brauchen immer Technik-, Security-, Compliance- und Kostenblick.",
      "questions": [
        {
          "id": "q1",
          "text": "1. Welche Antwort ist AP1-reif?",
          "options": [
            { "value": "a", "text": "Cloud uebernimmt alles, Kunde muss nichts mehr absichern" },
            { "value": "b", "text": "Cloud bietet Vorteile, erfordert aber Kundendisziplin bei IAM, Konfiguration, Compliance und Kosten" },
            { "value": "c", "text": "Cloud eignet sich nur fuer unkritische Systeme" }
          ],
          "correct": "b"
        },
        {
          "id": "q2",
          "text": "2. Was reduziert Lock-in-Risiko am ehesten?",
          "options": [
            { "value": "a", "text": "Moeglichst viele proprietaere Spezialdienste koppeln" },
            { "value": "b", "text": "Portabilitaet planen (Standards, Schnittstellen, Exit-Strategie)" },
            { "value": "c", "text": "Kostenalarme deaktivieren" }
          ],
          "correct": "b"
        },
        {
          "id": "q3",
          "text": "3. Welche Aussage zu Security ist korrekt?",
          "options": [
            { "value": "a", "text": "Fehlkonfiguration ist eine der haeufigsten Cloud-Ursachen fuer Sicherheitsvorfaelle" },
            { "value": "b", "text": "Open Buckets sind in Public Cloud normal und unkritisch" },
            { "value": "c", "text": "IAM spielt nur bei On-Prem eine Rolle" }
          ],
          "correct": "a"
        }
      ]
