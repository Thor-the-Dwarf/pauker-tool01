  "sections": [
    {
      "id": "service-model-sort-l2",
      "type": "sort",
      "title": "Raetsel 1: IaaS, PaaS oder SaaS?",
      "subtitle": "Ordne Szenarien dem passenden Service-Modell zu.",
      "hintDefault": "IaaS: viel Kontrolle. PaaS: App-Fokus. SaaS: fertige Anwendung.",
      "sortColumns": [
        { "zone": "iaas", "label": "IaaS", "hint": "Infra selbst steuern" },
        { "zone": "paas", "label": "PaaS", "hint": "Code deployen" },
        { "zone": "saas", "label": "SaaS", "hint": "fertigen Dienst nutzen" }
      ],
      "sortCards": [
        { "id": "sm1", "text": "Virtuelle Maschinen inkl. Netzwerksegment selbst verwalten", "correctZone": "iaas" },
        { "id": "sm2", "text": "Web-App deployen ohne OS-Patching", "correctZone": "paas" },
        { "id": "sm3", "text": "CRM direkt im Browser als Abo nutzen", "correctZone": "saas" },
        { "id": "sm4", "text": "Eigene Firewall-Regeln auf VM-Ebene definieren", "correctZone": "iaas" },
        { "id": "sm5", "text": "Runtime und Skalierung werden vom Dienst gemanagt", "correctZone": "paas" },
        { "id": "sm6", "text": "Fachbereich nutzt Collaboration-Tool ohne Serverbetrieb", "correctZone": "saas" },
        { "id": "sm7", "text": "Container-Orchestrierung als gemanagter Plattformdienst", "correctZone": "paas" },
        { "id": "sm8", "text": "Eigene Legacy-App auf selbst administrierten Instanzen", "correctZone": "iaas" }
      ]
    },
    {
      "id": "shared-responsibility-quiz-l2",
      "type": "quiz",
      "title": "Raetsel 2: Shared Responsibility vertieft",
      "subtitle": "Trenne Provider- und Kundenaufgaben sauber.",
      "hintDefault": "Provider sichert die Cloud, Kunde sichert Konfiguration, Daten und Identitaeten.",
      "questions": [
        {
          "id": "sr1",
          "text": "1. Welche Aussage ist korrekt?",
          "options": [
            { "value": "a", "text": "In SaaS entfaellt jede Kundenverantwortung fuer Zugriffsrechte." },
            { "value": "b", "text": "Auch in SaaS bleibt der Kunde fuer Nutzer-/Rollenkonzept und Datenfreigaben verantwortlich." },
            { "value": "c", "text": "In IaaS ist der Provider fuer alle Firewalleinstellungen verantwortlich." }
          ],
          "correct": "b"
        },
        {
          "id": "sr2",
          "text": "2. Was ist typischerweise Kundenthema in PaaS?",
          "options": [
            { "value": "a", "text": "Physische RZ-Sicherheit" },
            { "value": "b", "text": "IAM-Policies und Applikationskonfiguration" },
            { "value": "c", "text": "Austausch defekter Host-Hardware" }
          ],
          "correct": "b"
        },
        {
          "id": "sr3",
          "text": "3. Welche Pruefungsfalle ist korrekt benannt?",
          "options": [
            { "value": "a", "text": "Managed Service bedeutet automatisch DSGVO-Konformitaet ohne eigene Massnahmen." },
            { "value": "b", "text": "Managed Service reduziert Betriebsaufwand, aber Compliance- und Berechtigungspflichten bleiben beim Kunden." },
            { "value": "c", "text": "Shared Responsibility gilt nur fuer Public Cloud, nicht fuer Hybrid-Cloud." }
          ],
          "correct": "b"
        }
      ]
    },
    {
      "id": "risk-control-sort-l2",
      "type": "sort",
      "title": "Raetsel 3: Risiko und Gegenmassnahme",
      "subtitle": "Ordne jede Massnahme dem primaeren Risiko zu.",
      "hintDefault": "Kosten -> FinOps, Lock-in -> Portabilitaet, Fehlkonfig -> Least Privilege/Guardrails, Compliance -> Residency/Kontrollen.",
      "sortColumns": [
        { "zone": "cost", "label": "Kostenrisiko", "hint": "FinOps" },
        { "zone": "lockin", "label": "Lock-in-Risiko", "hint": "Portabilitaet" },
        { "zone": "misconfig", "label": "Fehlkonfiguration", "hint": "Security Guardrails" },
        { "zone": "compliance", "label": "Compliance/Residency", "hint": "Regulatorik" }
      ],
      "sortCards": [
        { "id": "rc1", "text": "Budgets und Alarme ab 80 Prozent Auslastung", "correctZone": "cost" },
        { "id": "rc2", "text": "Container + offene Standards statt proprietaerer Sonderdienste", "correctZone": "lockin" },
        { "id": "rc3", "text": "Policy-as-Code blockiert oeffentliche Buckets", "correctZone": "misconfig" },
        { "id": "rc4", "text": "Daten nur in zulaessigen Regionen speichern", "correctZone": "compliance" },
        { "id": "rc5", "text": "Rightsizing regelmaessig gegen Lastprofil pruefen", "correctZone": "cost" },
        { "id": "rc6", "text": "Exit-Strategie inkl. Datenexportpfad definieren", "correctZone": "lockin" },
        { "id": "rc7", "text": "Least-Privilege-IAM und periodische Rechte-Reviews", "correctZone": "misconfig" },
        { "id": "rc8", "text": "Vertragliche AVV/TOMs und Auditnachweise pflegen", "correctZone": "compliance" }
      ]
    },
