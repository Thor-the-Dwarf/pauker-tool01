  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Bin ich ein Cloud-Service-Modell (IaaS/PaaS/SaaS)?",
      "attributeKey": "is_service_model"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Geht es um Verantwortungsabgrenzung zwischen Anbieter und Kunde?",
      "attributeKey": "is_responsibility_model"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Steht Kostensteuerung und Wirtschaftlichkeit im Fokus?",
      "attributeKey": "is_cost_governance"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Stehen Sicherheitsleitplanken und Praevention im Mittelpunkt?",
      "attributeKey": "is_security_governance"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Bin ich ein Resilienz-/Verfuegbarkeits- oder DR-Architekturthema?",
      "attributeKey": "is_resilience_architecture"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Steht Compliance als Kernanforderung im Vordergrund?",
      "attributeKey": "is_compliance_focus"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Liegt mein Schwerpunkt primaer beim Anbieter (Cloud of the cloud)?",
      "attributeKey": "provider_scope"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Liegt mein Schwerpunkt primaer beim Kunden (Konfiguration, Daten, Zugriffe)?",
      "attributeKey": "customer_scope"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Nutze ich eine vom Anbieter gemanagte Laufzeit/Plattformabstraktion?",
      "attributeKey": "uses_managed_runtime"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Brauche ich typischerweise tiefe OS-/Infrastrukturkontrolle?",
      "attributeKey": "requires_os_control"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Adressiere ich direkt das Risiko proprietaerer Anbieterbindung?",
      "attributeKey": "addresses_lock_in"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Setze ich auf automatisierte Richtlinien in Pipelines statt nur Handpruefung?",
      "attributeKey": "uses_policy_automation"
    },
    {
      "id": "q13",
      "hotkey": "13",
      "text": "Ziele ich primaer auf Hochverfuegbarkeit im laufenden Betrieb?",
      "attributeKey": "targets_ha"
    },
    {
      "id": "q14",
      "hotkey": "14",
      "text": "Ziele ich primaer auf Disaster Recovery nach groesseren Ausfaellen?",
      "attributeKey": "targets_dr"
    },
    {
      "id": "q15",
      "hotkey": "15",
      "text": "Steuere ich den Datenstandort gemaess rechtlicher Vorgaben?",
      "attributeKey": "controls_data_location"
    }
  ],
