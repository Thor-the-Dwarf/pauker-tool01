  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Bin ich ein Cloud-Service-Modell (IaaS/PaaS/SaaS)?",
      "attributeKey": "is_service_model"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Bin ich ein gemanagter Dienst mit reduziertem Betriebsanteil?",
      "attributeKey": "is_managed_service"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Geht es um die Aufteilung von Verantwortlichkeiten?",
      "attributeKey": "is_responsibility_topic"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Steht Sicherheitsgovernance im Mittelpunkt?",
      "attributeKey": "is_security_topic"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Steht Kostensteuerung als Kernthema im Vordergrund?",
      "attributeKey": "is_cost_topic"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Ist Compliance der Hauptfokus?",
      "attributeKey": "is_compliance_topic"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Bin ich ein Verfuegbarkeits-/Resilienzthema?",
      "attributeKey": "is_resilience_topic"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Liegt mein Schwerpunkt primaer beim Anbieter?",
      "attributeKey": "provider_scope"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Liegt mein Schwerpunkt primaer beim Kunden?",
      "attributeKey": "customer_scope"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Brauche ich typischerweise hohe technische Kontrolltiefe?",
      "attributeKey": "needs_high_control"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Biete ich typischerweise geringen Betriebsaufwand fuer den Kunden?",
      "attributeKey": "offers_low_operation_effort"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Adressiere ich Portabilitaet und Wechselrisiko?",
      "attributeKey": "focuses_portability"
    },
    {
      "id": "q13",
      "hotkey": "13",
      "text": "Setze ich auf automatisierte Richtlinien in Deployments?",
      "attributeKey": "uses_policy_automation"
    },
    {
      "id": "q14",
      "hotkey": "14",
      "text": "Ziele ich primaer auf hohe Verfuegbarkeit im Betrieb?",
      "attributeKey": "targets_availability"
    },
    {
      "id": "q15",
      "hotkey": "15",
      "text": "Steuere ich den Datenstandort nach Vorgaben?",
      "attributeKey": "targets_data_location"
    },
    {
      "id": "q16",
      "hotkey": "16",
      "text": "Spiele ich eine direkte Rolle bei Identitaets- und Zugriffssteuerung?",
      "attributeKey": "focuses_identity_and_access"
    }
  ],
