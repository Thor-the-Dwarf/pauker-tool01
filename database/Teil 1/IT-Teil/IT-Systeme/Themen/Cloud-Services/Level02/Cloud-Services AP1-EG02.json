      "type": "sort",
      "title": "Raetsel 1: Komplexe Modellzuordnung",
      "subtitle": "Ordne jedes Szenario dem passendsten Servicemodell zu.",
      "hintDefault": "IaaS bei tiefer Systemkontrolle, PaaS bei Codefokus, SaaS bei fertiger Fachanwendung.",
      "sortColumns": [
        { "zone": "iaas", "label": "IaaS", "hint": "OS/Netz selber verwalten" },
        { "zone": "paas", "label": "PaaS", "hint": "Code deployen, Plattform gemanagt" },
        { "zone": "saas", "label": "SaaS", "hint": "Fertiges Produkt nutzen" }
      ],
      "sortCards": [
        { "id": "m1", "text": "Legacy-App braucht Root-Zugriff und eigenes Patchfenster", "correctZone": "iaas" },
        { "id": "m2", "text": "Team liefert nur API-Code, Runtime und Skalierung sind gemanagt", "correctZone": "paas" },
        { "id": "m3", "text": "CRM wird direkt per Browser genutzt", "correctZone": "saas" },
        { "id": "m4", "text": "Eigene Firewallregeln und Kernelparameter muessen gesetzt werden", "correctZone": "iaas" },
        { "id": "m5", "text": "Webservice laeuft auf gemanagter App-Plattform ohne OS-Admin", "correctZone": "paas" },
        { "id": "m6", "text": "Fachbereich braucht sofort nutzbares Ticketsystem", "correctZone": "saas" },
        { "id": "m7", "text": "Spezialsoftware verlangt proprietaeren Treiber im Gast-OS", "correctZone": "iaas" },
        { "id": "m8", "text": "Anwendungsdeploy ueber CI/CD auf standardisierter Laufzeit", "correctZone": "paas" },
        { "id": "m9", "text": "Mitarbeiter buchen Standard-Office-Loesung als Abonnement", "correctZone": "saas" }
      ]
    },
    {
      "id": "responsibility-quiz-l2",
      "type": "quiz",
      "title": "Raetsel 2: Shared Responsibility",
      "subtitle": "Klaere Verantwortungen ohne Pruefungsfalle.",
      "hintDefault": "Auch bei SaaS bleiben Kundenpflichten bei Identitaeten, Freigaben und Datenklassifizierung.",
      "questions": [
        {
          "id": "sr1",
          "text": "1. Welche Aussage ist fachlich korrekt?",
          "options": [
            { "value": "a", "text": "In SaaS uebernimmt der Anbieter automatisch Rollenpflege und Freigaben der Fachabteilung." },
            { "value": "b", "text": "In SaaS verantwortet der Kunde weiterhin Benutzerrechte, Datenfreigaben und Compliance-Prozesse." },
            { "value": "c", "text": "In IaaS liegt OS-Hardening komplett beim Anbieter." }
          ],
          "correct": "b"
        },
        {
          "id": "sr2",
          "text": "2. Was gehoert typischerweise zum Kundenanteil bei PaaS?",
          "options": [
            { "value": "a", "text": "Physische Sicherheit im Rechenzentrum" },
            { "value": "b", "text": "App-Konfiguration, Secrets-Management und IAM-Rollen" },
            { "value": "c", "text": "Austausch defekter Host-Hardware" }
          ],
          "correct": "b"
        },
        {
          "id": "sr3",
          "text": "3. Welche Pruefungsfalle ist richtig aufgeloest?",
          "options": [
            { "value": "a", "text": "Managed Service bedeutet immer automatisch compliance-konforme Nutzung." },
            { "value": "b", "text": "Managed Service reduziert Betriebslast, ersetzt aber nicht Governance und Kontrollpflichten." },
            { "value": "c", "text": "Shared Responsibility gilt nur fuer IaaS, nicht fuer SaaS." }
          ],
          "correct": "b"
        }
      ]
    },
    {
