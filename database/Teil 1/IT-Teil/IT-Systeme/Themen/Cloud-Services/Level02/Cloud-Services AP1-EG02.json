    {
      "id": "lockin-quiz-l2",
      "type": "quiz",
      "title": "Raetsel 5: Lock-in realistisch bewerten",
      "subtitle": "Worin liegt das Risiko und wie reduziert man es?",
      "hintDefault": "Lock-in ist vor allem Architektur- und Datenportabilitaetsthema.",
      "questions": [
        {
          "id": "l1",
          "text": "1. Was reduziert Lock-in-Risiko am wirksamsten?",
          "options": [
            { "value": "a", "text": "Ausschliesslich proprietaere Spezial-APIs nutzen" },
            { "value": "b", "text": "Offene Schnittstellen, Containerisierung und klarer Datenexportpfad" },
            { "value": "c", "text": "Kostenalarme deaktivieren" }
          ],
          "correct": "b"
        },
        {
          "id": "l2",
          "text": "2. Welche Aussage ist korrekt?",
          "options": [
            { "value": "a", "text": "Lock-in ist nur ein theoretisches Problem ohne Migrationskosten." },
            { "value": "b", "text": "Lock-in kann Wechselkosten, Projektlaufzeit und Betriebsrisiko deutlich erhoehen." },
            { "value": "c", "text": "Lock-in betrifft nur SaaS, nicht IaaS/PaaS." }
          ],
          "correct": "b"
        },
        {
          "id": "l3",
          "text": "3. Was gehoert in eine Exit-Strategie?",
          "options": [
            { "value": "a", "text": "Nur die Vertragslaufzeit" },
            { "value": "b", "text": "Datenexportformat, Verantwortlichkeiten, Testmigration und Downtime-Plan" },
            { "value": "c", "text": "Nur eine Liste bevorzugter Anbieter" }
          ],
          "correct": "b"
        }
      ]
    },
    {
      "id": "risk-control-sort-l2",
      "type": "sort",
      "title": "Raetsel 6: Risiko zu Gegenmassnahme",
      "subtitle": "Ordne jede Massnahme dem primaeren Risiko zu.",
      "hintDefault": "Kosten -> FinOps, Security -> IAM/Policies, Compliance -> Residency/AVV, Portabilitaet -> Exit-Design.",
      "sortColumns": [
        { "zone": "cost", "label": "Kostenrisiko", "hint": "Transparenz und Limits" },
        { "zone": "security", "label": "Security-Risiko", "hint": "Least Privilege und Guardrails" },
        { "zone": "compliance", "label": "Compliance-Risiko", "hint": "Data Residency und Nachweise" },
        { "zone": "portability", "label": "Lock-in-Risiko", "hint": "Architektur und Exit" }
      ],
      "sortCards": [
        { "id": "r1", "text": "Budgets mit Alarmstufen und Owner-Tagging", "correctZone": "cost" },
        { "id": "r2", "text": "MFA-Pflicht und rollenbasiertes Least Privilege", "correctZone": "security" },
        { "id": "r3", "text": "Vertragliche AVV/TOMs und Regionenbindung", "correctZone": "compliance" },
        { "id": "r4", "text": "Standardisierte APIs und regelmaessig getesteter Datenexport", "correctZone": "portability" },
        { "id": "r5", "text": "Auto-Shutdown fuer ungenutzte Testressourcen", "correctZone": "cost" },
        { "id": "r6", "text": "Policy as Code blockiert oeffentliche Storage-Freigaben", "correctZone": "security" },
        { "id": "r7", "text": "Auditfaehige Loesch- und Aufbewahrungsprozesse", "correctZone": "compliance" },
        { "id": "r8", "text": "Dokumentierter Umzugsplan auf alternative Plattform", "correctZone": "portability" }
      ]
    },
    {
      "id": "security-quiz-l2",
      "type": "quiz",
      "title": "Raetsel 7: Security-Fallen",
      "subtitle": "Trenne echte Sicherheitskontrollen von Fehlschluessen.",
      "hintDefault": "Der haeufigste Fehler ist nicht die Cloud an sich, sondern falsche Konfiguration.",
      "questions": [
        {
          "id": "s1",
          "text": "1. Welche Aussage ist korrekt?",
          "options": [
            { "value": "a", "text": "Managed Service macht Sicherheitskonfiguration ueberfluessig." },
            { "value": "b", "text": "Fehlkonfigurationen wie offene Buckets oder zu breite Rollen sind haeufige Incident-Ursachen." },
            { "value": "c", "text": "IAM ist nur in On-Prem relevant." }
          ],
          "correct": "b"
        },
        {
          "id": "s2",
          "text": "2. Welche Massnahme ist fuer privilegierte Konten zentral?",
          "options": [
            { "value": "a", "text": "MFA und getrennte Admin-Rollen" },
            { "value": "b", "text": "Nur laengere Passwoerter ohne weitere Kontrollen" },
            { "value": "c", "text": "Abschalten aller Audit-Logs" }
          ],
          "correct": "a"
        },
        {
          "id": "s3",
          "text": "3. Welche Kombination ist AP1-reif?",
          "options": [
            { "value": "a", "text": "Least Privilege, Logging, regelmaessige Rechte-Reviews, IaC-Policies" },
            { "value": "b", "text": "Nur Firewall-Regeln, sonst keine Governance" },
            { "value": "c", "text": "Nur Backup ohne Zugriffskontrolle" }
          ],
          "correct": "a"
        }
      ]
    },
    {
      "id": "final-quiz-l2",
      "type": "quiz",
      "title": "Finale: AP1-Gesamtentscheidung",
      "subtitle": "Waehle die fachlich robusteste Gesamtbewertung.",
      "hintDefault": "Service-Modell-Entscheidungen sind immer Trade-offs aus Kontrolle, Aufwand, Risiko und Wirtschaftlichkeit.",
      "questions": [
        {
          "id": "f1",
          "text": "1. Welche Aussage ist insgesamt korrekt?",
          "options": [
            { "value": "a", "text": "SaaS ist immer die beste Wahl, egal welche Anforderungen vorliegen." },
            { "value": "b", "text": "Das passende Modell ergibt sich aus Kontrollbedarf, Compliance, Betriebsfaehigkeit und Kostenzielen." },
            { "value": "c", "text": "IaaS ist veraltet und sollte grundsaetzlich vermieden werden." }
          ],
          "correct": "b"
        },
        {
          "id": "f2",
          "text": "2. Welche Kombination minimiert Betriebslast bei akzeptabler Anpassbarkeit haeufig?",
          "options": [
            { "value": "a", "text": "PaaS mit klaren Governance-Kontrollen" },
            { "value": "b", "text": "IaaS ohne Automatisierung" },
            { "value": "c", "text": "SaaS ohne Rollen- und Freigabekonzept" }
          ],
          "correct": "a"
        },
        {
          "id": "f3",
          "text": "3. Was ist fuer eine AP1-taugliche Begruendung unverzichtbar?",
          "options": [
            { "value": "a", "text": "Nur ein einzelner Vorteil" },
            { "value": "b", "text": "Abwaegung von Verantwortung, Sicherheit, Kosten und Portabilitaet" },
            { "value": "c", "text": "Nur Anbieterpraeferenz" }
          ],
          "correct": "b"
        }
      ]
    }
