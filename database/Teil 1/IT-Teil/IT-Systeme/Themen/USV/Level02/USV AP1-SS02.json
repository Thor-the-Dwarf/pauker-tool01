  "cards": [
    {
      "id": "card_001",
      "text": "Kurzzeitige Überbrückung plus Schutz vor Netzproblemen.",
      "correctForms": [
        "usv_grundzweck"
      ]
    },
    {
      "id": "card_002",
      "text": "Auslegung muss Wirkleistung und Scheinleistung gemeinsam berücksichtigen.",
      "correctForms": [
        "watt_vs_va"
      ]
    },
    {
      "id": "card_003",
      "text": "Verhältnis zwischen real nutzbarer Leistung und Scheinleistung.",
      "correctForms": [
        "leistungsfaktor"
      ]
    },
    {
      "id": "card_004",
      "text": "Überbrückungszeit verhält sich nicht linear zur Last und folgt Herstellerkurven.",
      "correctForms": [
        "runtime_kennlinie"
      ]
    },
    {
      "id": "card_005",
      "text": "Kapazitätsabnahme durch Alter und Zyklen reduziert reale Überbrückungszeit.",
      "correctForms": [
        "batteriealterung"
      ]
    },
    {
      "id": "card_006",
      "text": "Hohe Umgebungswärme verkürzt Akkulebensdauer deutlich.",
      "correctForms": [
        "temperatur_einfluss"
      ]
    },
    {
      "id": "card_007",
      "text": "Basis-Topologie mit Umschaltung auf Akku im Störfall.",
      "correctForms": [
        "offline_usv"
      ]
    },
    {
      "id": "card_008",
      "text": "Topologie mit Spannungsstabilisierung als Mittelweg.",
      "correctForms": [
        "line_interactive_usv"
      ]
    },
    {
      "id": "card_009",
      "text": "Topologie mit kontinuierlicher Entkopplung und höchstem Schutzlevel.",
      "correctForms": [
        "online_usv_double_conversion"
      ]
    },
    {
      "id": "card_010",
      "text": "Zeitspanne bis Batterieversorgung übernimmt.",
      "correctForms": [
        "umschaltzeit"
      ]
    },
    {
      "id": "card_011",
      "text": "Korrigiert Netzschwankungen ohne dauerhaften Batteriebetrieb.",
      "correctForms": [
        "spannungsregelung_avr"
      ]
    },
    {
      "id": "card_012",
      "text": "Sichert Lastversorgung bei internem USV-Fehlerpfad.",
      "correctForms": [
        "statischer_bypass"
      ]
    },
    {
      "id": "card_013",
      "text": "Ermöglicht Servicearbeiten an der USV ohne Lastunterbrechung.",
      "correctForms": [
        "wartungs_bypass"
      ]
    },
    {
      "id": "card_014",
      "text": "Zusatzmodul erhöht Verfügbarkeit bei Ausfall einzelner Komponenten.",
      "correctForms": [
        "n_1_redundanz"
      ]
    },
    {
      "id": "card_015",
      "text": "Nichtkritische Verbraucher werden gezielt abgeschaltet, um Kernlast länger zu halten.",
      "correctForms": [
        "load_shedding"
      ]
    },
    {
      "id": "card_016",
      "text": "Status- und Alarmdaten fließen automatisiert in zentrale Überwachung.",
      "correctForms": [
        "usv_monitoring_snmp_agent"
      ]
    },
    {
      "id": "card_017",
      "text": "Definiert Reihenfolge für sicheres Stoppen abhängiger Dienste.",
      "correctForms": [
        "geordnetes_shutdown_runbook"
      ]
    },
    {
      "id": "card_018",
      "text": "Überbrückt die Zeit bis ein Notstromaggregat stabil übernimmt.",
      "correctForms": [
        "usv_generator_kopplung"
      ]
    },
    {
      "id": "card_019",
      "text": "Validiert reale Runtime regelmäßig statt nur LED-Status zu vertrauen.",
      "correctForms": [
        "regelmassiger_last_batterietest"
      ]
    },
    {
      "id": "card_020",
      "text": "Berücksichtigt Lastwachstum und Reserve für zukünftige Erweiterungen.",
      "correctForms": [
        "usv_kapazitatsplanung"
      ]
    },
    {
      "id": "card_021",
      "text": "Ein einzelnes nicht-redundantes Element kann Gesamtausfall verursachen.",
      "correctForms": [
        "single_point_of_failure"
      ]
    },
    {
      "id": "card_022",
      "text": "Schutzkonzept wird an Kritikalität des Geschäftsprozesses ausgerichtet.",
      "correctForms": [
        "verfugbarkeitsanforderung"
      ]
    },
    {
      "id": "card_023",
      "text": "Nach Störung werden Verlauf, Maßnahmen und Verbesserungen nachvollziehbar festgehalten.",
      "correctForms": [
        "incident_dokumentation"
      ]
    },
    {
      "id": "card_024",
      "text": "\"USV ersetzt jedes Backup und macht Recovery-Konzepte überflüssig.\"",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_025",
      "text": "Dimensionierung, Monitoring und Runbook gehören gemeinsam zu einem belastbaren USV-Betrieb.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_026",
      "text": "Batteriezustand ist für Runtime-Prognosen irrelevant.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_027",
      "text": "Redundanz und Bypass können Verfügbarkeit in kritischen Umgebungen deutlich verbessern.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_028",
      "text": "Nur die Anschaffungskosten entscheiden über die passende USV-Topologie.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_029",
      "text": "Regelmäßige Tests reduzieren das Risiko von Überraschungen im Ernstfall.",
      "correctForms": [
        "alle"
      ]
    }
  ]
