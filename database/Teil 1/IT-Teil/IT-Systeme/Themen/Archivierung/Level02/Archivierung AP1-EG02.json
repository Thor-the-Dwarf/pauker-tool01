      ],
      "sortCards": [
        { "id": "a1", "text": "RPO/RTO spielen eine zentrale Rolle", "correctZone": "backup" },
        { "id": "a2", "text": "Aufbewahrungsfristen müssen regelbasiert eingehalten werden", "correctZone": "archiv" },
        { "id": "a3", "text": "Metadaten helfen beim späteren Auffinden", "correctZone": "archiv" },
        { "id": "a4", "text": "Versionierung erhöht Schutz gegen versehentliches Überschreiben", "correctZone": "backup" },
        { "id": "a5", "text": "Verschlüsselung ist sinnvoll für Vertraulichkeit", "correctZone": "beide" },
        { "id": "a6", "text": "Nachweise für Audit/Revision stehen im Vordergrund", "correctZone": "archiv" },
        { "id": "a7", "text": "Disaster-Recovery-Fall: schnelles Zurückspielen", "correctZone": "backup" },
        { "id": "a8", "text": "Zugriffskontrolle nach Berechtigungskonzept", "correctZone": "beide" }
      ]
    },
    {
      "id": "compliance-quiz-l2",
      "type": "quiz",
      "title": "Rätsel 2: Compliance und Revisionssicherheit",
      "subtitle": "Typische AP1-Fallen gezielt vermeiden.",
      "hintDefault": "Archivierung heißt nicht nur Speichern, sondern nachvollziehbare, unveränderbare und auffindbare Ablage.",
      "questions": [
        {
          "id": "c1",
          "text": "1. Welche Aussage ist fachlich korrekt?",
          "options": [
            { "value": "a", "text": "Ein Backup ersetzt immer ein revisionssicheres Archiv." },
            { "value": "b", "text": "Ein Archiv benötigt oft Aufbewahrungsregeln, Unveränderbarkeit und Suchbarkeit." },
            { "value": "c", "text": "Ein Archiv ist nur eine alte Festplatte ohne Struktur." }
          ],
          "correct": "b"
        },
        {
          "id": "c2",
          "text": "2. Welche Maßnahme stärkt Revisionssicherheit am besten?",
          "options": [
            { "value": "a", "text": "Dateien jederzeit überschreiben lassen" },
            { "value": "b", "text": "WORM/Unveränderbarkeit plus Protokollierung" },
            { "value": "c", "text": "Nur Dateinamen verkürzen" }
          ],
          "correct": "b"
        },
        {
          "id": "c3",
          "text": "3. Warum sind Metadaten im Archiv entscheidend?",
          "options": [
            { "value": "a", "text": "Nur Metadaten können Backups schneller machen" },
            { "value": "b", "text": "Sie ermöglichen zielgerichtete Suche, Fristensteuerung und Nachvollziehbarkeit" },
            { "value": "c", "text": "Metadaten sind bei Langzeitaufbewahrung verboten" }
          ],
          "correct": "b"
        },
        {
          "id": "c4",
          "text": "4. Welche Aussage zu Löschkonzepten ist korrekt?",
          "options": [
            { "value": "a", "text": "Archivdaten dürfen nie gelöscht werden" },
            { "value": "b", "text": "Nach Ablauf rechtlicher Fristen muss regelkonforme Löschung möglich sein" },
            { "value": "c", "text": "Löschung ist nur bei Backups relevant" }
          ],
          "correct": "b"
        }
      ]
    },
