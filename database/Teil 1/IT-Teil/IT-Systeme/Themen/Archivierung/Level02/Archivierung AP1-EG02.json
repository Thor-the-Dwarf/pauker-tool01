    {
      "id": "szenarien-quiz-l2",
      "type": "quiz",
      "title": "Rätsel 5: Architekturentscheidungen",
      "subtitle": "Entscheide, welche Kombination fachlich tragfähig ist.",
      "hintDefault": "Backup und Archiv ergänzen sich. Ein System allein deckt selten alle Ziele vollständig ab.",
      "questions": [
        {
          "id": "s1",
          "text": "1. Was ist die fachlich sauberste Aussage?",
          "options": [
            { "value": "a", "text": "Ein tägliches Backup erfüllt automatisch alle Archiv- und Compliance-Anforderungen" },
            { "value": "b", "text": "Archivierung benötigt neben Speicherung auch Regeln für Unveränderbarkeit, Auffindbarkeit und Fristen" },
            { "value": "c", "text": "Archivierung ist nur sinnvoll, wenn nie gelöscht wird" }
          ],
          "correct": "b"
        },
        {
          "id": "s2",
          "text": "2. Welcher Test belegt Backup-Qualität am besten?",
          "options": [
            { "value": "a", "text": "Nur prüfen, ob Sicherungsdatei existiert" },
            { "value": "b", "text": "Regelmäßiger Restore-Test gegen definierte RTO/RPO-Ziele" },
            { "value": "c", "text": "Dateigröße der Sicherung vergleichen" }
          ],
          "correct": "b"
        },
        {
          "id": "s3",
          "text": "3. Warum reicht 'Dateien schreibgeschützt speichern' für revisionssichere Archivierung oft nicht aus?",
          "options": [
            { "value": "a", "text": "Schreibschutz allein gewährleistet keine manipulationssichere Historie und keine Fristenlogik" },
            { "value": "b", "text": "Schreibschutz ist technisch unmöglich" },
            { "value": "c", "text": "Archivierung braucht grundsätzlich keine Integritätsmaßnahmen" }
          ],
          "correct": "a"
        },
        {
          "id": "s4",
          "text": "4. Welche Kombination passt für ein mittelständisches Unternehmen am besten?",
          "options": [
            { "value": "a", "text": "Nur Cloud-Backup ohne Archivkonzept" },
            { "value": "b", "text": "Backup-Strategie für Restore + regelbasiertes Archiv mit Metadaten und Retention" },
            { "value": "c", "text": "Nur Archiv, keine Wiederherstellungsstrategie" }
          ],
          "correct": "b"
        }
      ]
    },
