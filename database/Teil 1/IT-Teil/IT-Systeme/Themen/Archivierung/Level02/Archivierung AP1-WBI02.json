  "questions": [
    {
      "id": "q01",
      "hotkey": "1",
      "text": "Geht es primär um Backup/Restore im Störungsfall?",
      "attributeKey": "is_backup"
    },
    {
      "id": "q02",
      "hotkey": "2",
      "text": "Geht es primär um langfristige Archivierung?",
      "attributeKey": "is_archive"
    },
    {
      "id": "q03",
      "hotkey": "3",
      "text": "Stehen RTO/RPO-Ziele im Zentrum?",
      "attributeKey": "focus_rto_rpo"
    },
    {
      "id": "q04",
      "hotkey": "4",
      "text": "Stehen Compliance- und Aufbewahrungsanforderungen im Zentrum?",
      "attributeKey": "focus_retention_compliance"
    },
    {
      "id": "q05",
      "hotkey": "5",
      "text": "Ist Unveränderbarkeit eine Kernanforderung?",
      "attributeKey": "needs_immutability"
    },
    {
      "id": "q06",
      "hotkey": "6",
      "text": "Ist Suchbarkeit bzw. Retrieval-Fähigkeit zentral?",
      "attributeKey": "needs_searchability"
    },
    {
      "id": "q07",
      "hotkey": "7",
      "text": "Muss schnelle technische Wiederherstellung möglich sein?",
      "attributeKey": "supports_fast_restore"
    },
    {
      "id": "q08",
      "hotkey": "8",
      "text": "Sind nachvollziehbare Audit-Protokolle erforderlich?",
      "attributeKey": "requires_audit_trail"
    },
    {
      "id": "q09",
      "hotkey": "9",
      "text": "Sind reguläre Änderungen/Überschreiben typischerweise erlaubt?",
      "attributeKey": "allows_regular_modification"
    },
    {
      "id": "q10",
      "hotkey": "10",
      "text": "Muss eine Legal-Hold-Funktion berücksichtigt werden?",
      "attributeKey": "requires_legal_hold_support"
    },
    {
      "id": "q11",
      "hotkey": "11",
      "text": "Spielt eine Retention-Policy zentrale Rolle?",
      "attributeKey": "focuses_on_retention_policy"
    },
    {
      "id": "q12",
      "hotkey": "12",
      "text": "Sind Metadaten/Indexierung essenziell?",
      "attributeKey": "uses_metadata_indexing"
    },
    {
      "id": "q13",
      "hotkey": "13",
      "text": "Ist Versionierung ein zentraler Bestandteil?",
      "attributeKey": "supports_versioning"
    },
    {
      "id": "q14",
      "hotkey": "14",
      "text": "Ist es stark mit Disaster-Recovery-Szenarien verknüpft?",
      "attributeKey": "supports_disaster_recovery"
    }
  ],
