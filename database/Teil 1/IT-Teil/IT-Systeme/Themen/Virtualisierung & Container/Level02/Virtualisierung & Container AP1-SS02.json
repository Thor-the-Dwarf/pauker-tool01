  "cards": [
    {
      "id": "card_001",
      "text": "Virtualisierungsschicht läuft direkt auf Hardware ohne allgemeines Host-OS.",
      "correctForms": [
        "hypervisor_typ_1_bare_metal"
      ]
    },
    {
      "id": "card_002",
      "text": "Virtualisierung wird als Anwendung auf einem bestehenden Betriebssystem betrieben.",
      "correctForms": [
        "hypervisor_typ_2_hosted"
      ]
    },
    {
      "id": "card_003",
      "text": "Eigene Gast-OS pro Instanz bilden eine starke Trennungsgrenze.",
      "correctForms": [
        "vm_isolationsgrenze"
      ]
    },
    {
      "id": "card_004",
      "text": "Mehrere Instanzen teilen denselben Host-Kernel.",
      "correctForms": [
        "container_kernel_sharing"
      ]
    },
    {
      "id": "card_005",
      "text": "Steuert Lebenszyklus einzelner Containerinstanzen auf Node-Ebene.",
      "correctForms": [
        "container_runtime"
      ]
    },
    {
      "id": "card_006",
      "text": "Planung, Desired State und flächige Rolloutsteuerung liegen hier zentral.",
      "correctForms": [
        "orchestrierungs_control_plane"
      ]
    },
    {
      "id": "card_007",
      "text": "Versionstausch in kleinen Schritten reduziert Ausfallrisiko während Updates.",
      "correctForms": [
        "rolling_update"
      ]
    },
    {
      "id": "card_008",
      "text": "Definierter Rückweg auf letzte stabile Version.",
      "correctForms": [
        "rollback_strategie"
      ]
    },
    {
      "id": "card_009",
      "text": "Instanzzahl passt sich automatisch Lastmetriken an.",
      "correctForms": [
        "autoscaling"
      ]
    },
    {
      "id": "card_010",
      "text": "CPU-/RAM-Vorgaben verhindern ungeplante Verdrängung anderer Workloads.",
      "correctForms": [
        "resource_requests_limits"
      ]
    },
    {
      "id": "card_011",
      "text": "Dienstart benötigt dauerhaftes Datenkonzept und Wiederherstellungsstrategie.",
      "correctForms": [
        "stateful_workload"
      ]
    },
    {
      "id": "card_012",
      "text": "Dienstart lässt sich leicht replizieren und ohne Datenpersistenz neu starten.",
      "correctForms": [
        "stateless_workload"
      ]
    },
    {
      "id": "card_013",
      "text": "Daten überleben den Neustart einer Containerinstanz.",
      "correctForms": [
        "persistentes_volume"
      ]
    },
    {
      "id": "card_014",
      "text": "Stellt Wiederherstellungspunkte für Daten und Zustände bereit.",
      "correctForms": [
        "snapshot_backup_konzept"
      ]
    },
    {
      "id": "card_015",
      "text": "Begrenzt explizit erlaubte Kommunikationspfade zwischen Services.",
      "correctForms": [
        "netzwerk_policy"
      ]
    },
    {
      "id": "card_016",
      "text": "Verhindert hartkodierte Zugangsdaten in Images und Config-Dateien.",
      "correctForms": [
        "secret_management"
      ]
    },
    {
      "id": "card_017",
      "text": "Minimiert Angriffsfläche und blockiert Deployments bei kritischen Schwachstellen.",
      "correctForms": [
        "image_hardening"
      ]
    },
    {
      "id": "card_018",
      "text": "Korrelation aus Logs, Metriken und Traces für End-to-End-Fehleranalyse.",
      "correctForms": [
        "observability_stack"
      ]
    },
    {
      "id": "card_019",
      "text": "Steuert Service-zu-Service-Verkehr und Policies auf Netzwerkebene fein granular.",
      "correctForms": [
        "service_mesh"
      ]
    },
    {
      "id": "card_020",
      "text": "Kombiniert VM- und Containerbetrieb entsprechend Workload-Anforderungen.",
      "correctForms": [
        "hybridmuster_vm_container"
      ]
    },
    {
      "id": "card_021",
      "text": "Plant Ressourcenreserven anhand Wachstum, Lastprofilen und SLO-Zielen.",
      "correctForms": [
        "kapazitatsplanung"
      ]
    },
    {
      "id": "card_022",
      "text": "Architekturentscheidung wird durch regulatorische Trennpflichten bestimmt.",
      "correctForms": [
        "compliance_mandantengrenze"
      ]
    },
    {
      "id": "card_023",
      "text": "Gezielte Störungstests prüfen Recovery und Fehlertoleranz im Echtbetrieb.",
      "correctForms": [
        "resilienztest_chaos_ubung"
      ]
    },
    {
      "id": "card_024",
      "text": "Standardisierte Incident-Schritte sichern reproduzierbare Reaktion und Wiederanlauf.",
      "correctForms": [
        "betriebs_runbook"
      ]
    },
    {
      "id": "card_025",
      "text": "\"Container ersetzen grundsätzlich jedes Backup- und Recovery-Konzept.\"",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_026",
      "text": "Sichere Plattformen brauchen Policies, Secret-Handhabung und Image-Hygiene gemeinsam.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_027",
      "text": "Stateful und stateless Workloads können ohne Unterschied gleich behandelt werden.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_028",
      "text": "Rolling Update, Observability und Runbook ergänzen sich im stabilen Betrieb.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_029",
      "text": "Hypervisor-Typ und Workload-Anforderungen sind für Architekturentscheidungen irrelevant.",
      "correctForms": [
        "keine"
      ]
    }
  ]
