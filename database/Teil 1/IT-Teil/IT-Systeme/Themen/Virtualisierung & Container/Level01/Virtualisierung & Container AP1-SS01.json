  "cards": [
    {
      "id": "card_001",
      "text": "Eine VM bringt pro Instanz ein eigenes Betriebssystem mit (eigener Kernel, eigene Systemdienste).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Hypervisor verwaltet mehrere virtuelle Maschinen auf einem Host (Ressourcen wie CPU/RAM/Storage werden zugeteilt).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "VMs bieten starke Isolation, weil jede VM wie ein eigener Computer mit eigenem OS wirkt.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "VMs haben mehr Overhead, weil pro VM ein komplettes OS mitläuft (Bootzeit, Updates, RAM/Storage).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Container teilen sich den Kernel des Hosts: Prozesse laufen isoliert, aber nicht mit eigenem Kernel pro Container.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Container starten meist deutlich schneller und sind „leichter“ als VMs (weniger Overhead).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Container-Isolation ist anders: Sicherheitsgrenzen hängen stark von Kernel, Namespaces/Permissions und Konfiguration ab.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Prüfungsfalle: Container sind keine „Mini-VMs“ – sie teilen Kernel und verhalten sich deshalb anders bei Treibern/Kernel-Funktionen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Nutzen von Virtualisierung: bessere Hardware-Auslastung durch Konsolidierung vieler Systeme auf weniger Hosts.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Nutzen von Containern: schnelles Deployment durch Images und reproduzierbare Laufzeitumgebungen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Testumgebungen lassen sich mit Containern oft sehr schnell aufziehen und wieder wegwerfen (sauberer Zustand).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "Prüfungsfalle: Ein Container ersetzt nicht automatisch ein vollständiges Betriebssystem, wenn du OS-spezifische Dinge brauchst.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "„Jeder Container hat immer ein eigenes Betriebssystem mit eigenem Kernel.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "„Eine VM teilt sich immer den Kernel des Hosts und ist deshalb so leicht wie ein Container.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "Virtualisierung und Container helfen bei Auslastung, schnellem Deployment und testbaren Umgebungen – je nach Bedarf mit anderer Isolation und anderem Overhead.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
