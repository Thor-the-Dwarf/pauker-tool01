  "cards": [
    {
      "id": "card_001",
      "text": "Stellt die grundlegende Plattform bereit, auf der Programme laufen (Kernel, Hardwarezugriff, Benutzerverwaltung).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Treiber sind Systemsoftware: Sie verbinden Betriebssystem und konkrete Hardware (z. B. Netzwerkkarte, GPU, Drucker).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Dienste/Services im Hintergrund (z. B. Update-Dienst, Druckwarteschlange, Zeitdienst) zählen zur Systemsoftware.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Ein Backup-Agent, der im Hintergrund Sicherungen ausführt, ist typischerweise Systemsoftware/Tooling.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Monitoring-Agent (Metriken/Healthchecks/Alerts) läuft meist als Dienst und zählt zur Systemsoftware.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Anwendungssoftware dient direkt Nutzeraufgaben: Texte schreiben, mailen, browsen, planen, kommunizieren.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Office-Programme, Browser und Mail-Clients sind klassische Anwendungssoftware.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "ERP/CRM sind Anwendungssoftware, weil sie Geschäftsprozesse abbilden (z. B. Aufträge, Kunden, Rechnungen).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Eine IDE (Entwicklungsumgebung) ist Anwendungssoftware, auch wenn sie „technisch“ wirkt.",
      "correctForms": [
        "ide"
      ]
    },
    {
      "id": "card_010",
      "text": "Prüfungsfalle: Ein Antivirus/EDR-Agent kann als Systemdienst laufen, obwohl es „wie eine App“ aussieht.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Proprietär bedeutet: Quellcode nicht offen; Nutzung nach Herstellerlizenz, oft mit Einschränkungen bei Weitergabe/Änderung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "Open Source bedeutet nicht automatisch kostenlos: Entscheidend sind die Lizenzrechte (Nutzung, Änderung, Weitergabe).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Abo-Modell: Nutzung ist zeitgebunden (z. B. pro Monat/Jahr), oft mit Updates/Support gekoppelt.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "Kauf-/Perpetual-Lizenz: Einmalige Lizenz, Updates/Support können separat sein oder zeitlich begrenzt.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "Systemsoftware vs. Anwendungssoftware sauber trennen heißt: Basisbetrieb/Hardwarezugriff vs. konkrete Nutzeraufgaben.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_016",
      "text": "„Ein Treiber ist Anwendungssoftware, weil man ihn installieren und starten kann.“",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
