  "cards": [
    {
      "id": "card_001",
      "text": "Einmalig, zeitlich befristet, klares Ziel und Abschluss.",
      "correctForms": [
        "projekt"
      ]
    },
    {
      "id": "card_002",
      "text": "Wiederholbarer Standardablauf im Betrieb.",
      "correctForms": [
        "prozess"
      ]
    },
    {
      "id": "card_003",
      "text": "Kleine taegliche Regelaufgabe ohne eigenen Projektcharakter.",
      "correctForms": [
        "linie_routine"
      ]
    },
    {
      "id": "card_004",
      "text": "Begruendet Nutzen, Kosten und Risiken eines Vorhabens vor Start.",
