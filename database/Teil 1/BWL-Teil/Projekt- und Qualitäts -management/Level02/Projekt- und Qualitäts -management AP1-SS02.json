        "business_case"
      ]
    },
    {
      "id": "card_005",
      "text": "Formale Startfreigabe mit Rahmen, Rollen und Verantwortungen.",
      "correctForms": [
        "projektauftrag"
      ]
    },
    {
      "id": "card_006",
      "text": "Spezifisch, messbar, akzeptiert, realistisch, terminiert.",
      "correctForms": [
