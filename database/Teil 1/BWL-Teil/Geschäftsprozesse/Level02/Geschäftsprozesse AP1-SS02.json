  "cards": [
    {
      "id": "card_001",
      "text": "Ablauf aus Unternehmenssicht mit Fokus auf Wertschöpfung, Verantwortlichkeit und Ergebnis für Kunde/Organisation.",
      "correctForms": [
        "geschaftsprozess"
      ]
    },
    {
      "id": "card_002",
      "text": "Konkrete operative Schrittfolge im Team, z. B. Ticket erfassen, priorisieren, lösen, dokumentieren.",
      "correctForms": [
        "arbeitsprozess"
      ]
    },
    {
      "id": "card_003",
      "text": "Einmalig, zeitlich befristet und mit eigenem Ziel/Budget organisiert.",
      "correctForms": [
        "projekt"
      ]
    },
    {
      "id": "card_004",
      "text": "Prozessart mit direktem Kundennutzen und typischer Marktwirkung.",
      "correctForms": [
        "kernprozess"
      ]
    },
    {
      "id": "card_005",
      "text": "Prozessart, die Ressourcen bereitstellt und den Kernprozess absichert.",
      "correctForms": [
        "unterstutzungsprozess"
      ]
    },
    {
      "id": "card_006",
      "text": "Strategie, Zielvorgaben, Steuerung und Kontrolle von Prozessen.",
      "correctForms": [
        "fuhrungsprozess"
      ]
    },
    {
      "id": "card_007",
      "text": "Übersicht, die Kern-, Support- und Führungsprozesse inklusive Beziehungen zeigt.",
      "correctForms": [
        "prozesslandkarte"
      ]
    },
    {
      "id": "card_008",
      "text": "Vom Trigger bis zum bestätigten Ergebnis inkl. aller Übergaben gedacht.",
      "correctForms": [
        "end_to_end_prozess"
      ]
    },
    {
      "id": "card_009",
      "text": "Rolle mit Verantwortung für Zielerreichung, Regelwerk und kontinuierliche Verbesserung.",
      "correctForms": [
        "prozess_owner"
      ]
    },
    {
      "id": "card_010",
      "text": "Messgröße zur Steuerung eines Ziels, z. B. Verfügbarkeit oder Durchlaufzeit.",
      "correctForms": [
        "kpi"
      ]
    },
    {
      "id": "card_011",
      "text": "Kombination mehrerer Kennzahlen, um einseitige Fehlanreize zu vermeiden.",
      "correctForms": [
        "kpi_set"
      ]
    },
    {
      "id": "card_012",
      "text": "Gesamtzeit eines Falls inkl. Wartephasen und aktiver Bearbeitung.",
      "correctForms": [
        "durchlaufzeit"
      ]
    },
    {
      "id": "card_013",
      "text": "Reine aktive Arbeitszeit ohne Liege- und Wartezeiten.",
      "correctForms": [
        "bearbeitungszeit"
      ]
    },
    {
      "id": "card_014",
      "text": "Kennzahl: Fälle werden ohne Nacharbeit und ohne Wiedereröffnung korrekt abgeschlossen.",
      "correctForms": [
        "first_time_right"
      ]
    },
    {
      "id": "card_015",
      "text": "Schritt/Ressource mit geringster Kapazität, die den Gesamtdurchsatz begrenzt.",
      "correctForms": [
        "engpass_bottleneck"
      ]
    },
    {
      "id": "card_016",
      "text": "Begrenzung paralleler Arbeit, um Kontextwechsel und Stau zu reduzieren.",
      "correctForms": [
        "wip_limit"
      ]
    },
    {
      "id": "card_017",
      "text": "Definierter Übergabepunkt zwischen Rollen oder Systemen mit klaren Informationsanforderungen.",
      "correctForms": [
        "schnittstelle"
      ]
    },
    {
      "id": "card_018",
      "text": "Toolwechsel (z. B. Ticket → Mail → Excel) erzeugt Verzögerung und Informationsverlust.",
      "correctForms": [
        "medienbruch"
      ]
    },
    {
      "id": "card_019",
      "text": "Wiederholbarer Regelablauf mit klaren Rollen, Schritten und Qualitätskriterien.",
      "correctForms": [
        "standardprozess"
      ]
    },
    {
      "id": "card_020",
      "text": "Sonderpfad für seltene Fälle außerhalb des normalen Regelablaufs.",
      "correctForms": [
        "ausnahmeprozess"
      ]
    },
    {
      "id": "card_021",
      "text": "Sache/Produkt gegen Geld; Eigentumsübergang steht im Vordergrund.",
      "correctForms": [
        "kaufvertrag"
      ]
    },
    {
      "id": "card_022",
      "text": "Vertragstyp, bei dem ein konkreter Erfolg geschuldet wird; Abnahme ist zentral.",
      "correctForms": [
        "werkvertrag"
      ]
    },
    {
      "id": "card_023",
      "text": "Vertragstyp, bei dem die Tätigkeit nach Aufwand geschuldet wird.",
      "correctForms": [
        "dienstvertrag"
      ]
    },
    {
      "id": "card_024",
      "text": "Formale Bestätigung, dass das vereinbarte Werk vertragsgemäß erfüllt ist.",
      "correctForms": [
        "abnahme"
      ]
    },
    {
      "id": "card_025",
      "text": "Leistung weicht von der vereinbarten Beschaffenheit/Funktion ab.",
      "correctForms": [
        "mangel"
      ]
    },
    {
      "id": "card_026",
      "text": "Verbindlicher Termin wird nicht eingehalten, Leistung kommt zu spät.",
      "correctForms": [
        "lieferverzug"
      ]
    },
    {
      "id": "card_027",
      "text": "Fällige Rechnung wird trotz Frist/ Mahnung nicht gezahlt.",
      "correctForms": [
        "zahlungsverzug"
      ]
    },
    {
      "id": "card_028",
      "text": "Vertraglich vereinbarte Serviceziele gegenüber dem Kunden (z. B. Reaktionszeit, Verfügbarkeit).",
      "correctForms": [
        "sla"
      ]
    },
    {
      "id": "card_029",
      "text": "Interne Leistungszusage zwischen Teams, um externe Serviceziele sicherzustellen.",
      "correctForms": [
        "ola"
      ]
    },
    {
      "id": "card_030",
      "text": "Gesamtkosten über Lebensdauer inkl. Betrieb, Wartung, Schulung und Support.",
      "correctForms": [
        "tco"
      ]
    },
    {
      "id": "card_031",
      "text": "Nutzen/Gewinn im Verhältnis zur Investition, immer mit Zeitraum betrachtet.",
      "correctForms": [
        "roi"
      ]
    },
    {
      "id": "card_032",
      "text": "Zeitpunkt, ab dem kumulierter Nutzen die Investitionskosten erreicht.",
      "correctForms": [
        "amortisation"
      ]
    },
    {
      "id": "card_033",
      "text": "Entscheidungsmethode mit Kriterien, Gewichtung und Punktbewertung.",
      "correctForms": [
        "nutzwertanalyse"
      ]
    },
    {
      "id": "card_034",
      "text": "Strategische Entscheidung: selbst entwickeln oder einkaufen/outsourcen.",
      "correctForms": [
        "make_or_buy"
      ]
    },
    {
      "id": "card_035",
      "text": "Erwartete Zusatzkosten aus Risiken wie Ausfall, Pönalen, Verzögerungen.",
      "correctForms": [
        "risikokosten"
      ]
    },
    {
      "id": "card_036",
      "text": "Ziel muss spezifisch, messbar, akzeptiert, realistisch und terminiert formuliert sein.",
      "correctForms": [
        "prozessziel_smart"
      ]
    },
    {
      "id": "card_037",
      "text": "Messbar formuliert: „Gilt als erfüllt, wenn ...“.",
      "correctForms": [
        "akzeptanzkriterium"
      ]
    },
    {
      "id": "card_038",
      "text": "Systematische Ermittlung der eigentlichen Ursache statt reiner Symptombehandlung.",
      "correctForms": [
        "ursachenanalyse"
      ]
    },
    {
      "id": "card_039",
      "text": "Strukturiertes Lernen aus Vorfällen zur dauerhaften Prozessverbesserung.",
      "correctForms": [
        "lessons_learned"
      ]
    },
    {
      "id": "card_040",
      "text": "Vordefinierter Hochstufungsweg bei Überschreitung von Risiko, Zeit oder Kompetenz.",
      "correctForms": [
        "eskalation"
      ]
    },
    {
      "id": "card_041",
      "text": "Welche drei Begriffe gehören in ein ausgewogenes Incident-Steuerungsset: Durchlaufzeit, First Time Right, Reopen-Rate?",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_042",
      "text": "Welche Aussage ist korrekt: „Nur viele geschlossene Tickets bedeuten automatisch hohe Servicequalität.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_043",
      "text": "Prüfungsfalle: Ein KPI ohne Zielbezug kann Verhalten verschlechtern statt verbessern.",
      "correctForms": [
        "kpi"
      ]
    },
    {
      "id": "card_044",
      "text": "Der Wechsel von Prozessschritten über mehrere unintegrierte Tools erhöht Fehlerquote und Laufzeit.",
      "correctForms": [
        "medienbruch"
      ]
    }
  ]
}
