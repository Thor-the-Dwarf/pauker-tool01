    {
      "id": "kpi-fallen-quiz",
      "type": "quiz",
      "title": "Rätsel 3: KPI-Design ohne Fehlanreize",
      "subtitle": "Wähle die fachlich stärkste Aussage.",
      "hintDefault": "Prüfungsfalle: Eine isolierte Kennzahl kann Verhalten verschlechtern.",
      "questions": [
        {
          "id": "kq1",
          "text": "1. Welcher KPI-Satz ist für Incident-Management am robustesten?",
          "options": [
            { "value": "a", "text": "Nur Anzahl geschlossener Tickets pro Tag." },
            { "value": "b", "text": "Durchlaufzeit + Erstlösungsquote + Reopen-Rate." },
            { "value": "c", "text": "Nur durchschnittliche Gesprächsdauer im Service Desk." }
          ],
          "correct": "b"
        },
        {
          "id": "kq2",
          "text": "2. Warum reicht „Schnelligkeit“ als alleiniger KPI oft nicht aus?",
          "options": [
            { "value": "a", "text": "Weil Kennzahlen generell in Prozessen verboten sind." },
            { "value": "b", "text": "Weil Teams sonst zu gründlich arbeiten und zu wenig schließen." },
            { "value": "c", "text": "Weil Qualität/Wirksamkeit ungemessen bleibt und Fehlanreize entstehen." }
          ],
          "correct": "c"
        },
        {
          "id": "kq3",
          "text": "3. Welche Aussage zum Prozess-Owner ist korrekt?",
          "options": [
            { "value": "a", "text": "Owner ist nur Dokumentationsrolle ohne Entscheidungsbefugnis." },
            { "value": "b", "text": "Owner verantwortet Zielerreichung, Regelwerk und Verbesserung des Prozesses." },
            { "value": "c", "text": "Owner muss jeden Einzelfall operativ selbst bearbeiten." }
          ],
          "correct": "b"
        },
        {
          "id": "kq4",
          "text": "4. Welche Maßnahme reduziert KPI-Manipulation am wirksamsten?",
          "options": [
            { "value": "a", "text": "Nur die schnellsten Ticket-Schließer belohnen." },
            { "value": "b", "text": "KPI-Set mit Gegenindikatoren und regelmäßiger Ursachenanalyse." },
            { "value": "c", "text": "KPI-Berichte abschaffen, um Druck herauszunehmen." }
          ],
          "correct": "b"
        }
      ]
    },
