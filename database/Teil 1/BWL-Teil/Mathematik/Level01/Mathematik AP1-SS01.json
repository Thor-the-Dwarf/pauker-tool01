  "cards": [
    {
      "id": "card_001",
      "text": "Wird typischerweise für Netzwerkgeschwindigkeiten verwendet (z. B. Mbit/s).",
      "correctForms": [
        "bit"
      ]
    },
    {
      "id": "card_002",
      "text": "Wird typischerweise für Dateigrößen verwendet (z. B. MB/MiB).",
      "correctForms": [
        "byte"
      ]
    },
    {
      "id": "card_003",
      "text": "1 Byte entspricht 8 bit.",
      "correctForms": [
        "byte"
      ]
    },
    {
      "id": "card_004",
      "text": "1 kB = 1.000 Byte (Herstellerangaben bei Datenträgern).",
      "correctForms": [
        "si_system_dezimal"
      ]
    },
    {
      "id": "card_005",
      "text": "1 KiB = 1.024 Byte (Anzeige im Betriebssystem/Arbeitsspeicher-Kontext).",
      "correctForms": [
        "iec_system_binar"
      ]
    },
    {
      "id": "card_006",
      "text": "500 GB (Hersteller) erscheinen im Betriebssystem als ca. 465 GiB – das ist kein Defekt, sondern ein Präfix-Unterschied.",
      "correctForms": [
        "iec_system_binar"
      ]
    },
    {
      "id": "card_007",
      "text": "Formel: W = (p/100) · G",
      "correctForms": [
        "prozentwert_w"
      ]
    },
    {
      "id": "card_008",
      "text": "Formel: G = W · (100/p)",
      "correctForms": [
        "grundwert_g"
      ]
    },
    {
      "id": "card_009",
      "text": "Formel: p = (W/G) · 100",
      "correctForms": [
        "prozentsatz_p"
      ]
    },
    {
      "id": "card_010",
      "text": "Von 10% auf 12%: Das sind +2 … (nicht „+2%“ im relativen Sinn).",
      "correctForms": [
        "prozentpunkte"
      ]
    },
    {
      "id": "card_011",
      "text": "Grundformel: Zeit = Datenmenge / Rate (Einheiten vorher angleichen!).",
      "correctForms": [
        "transferzeit"
      ]
    },
    {
      "id": "card_012",
      "text": "100 Mbit/s entsprechen theoretisch 12,5 MB/s (Faktor 8 beachten).",
      "correctForms": [
        "datenrate"
      ]
    },
    {
      "id": "card_013",
      "text": "Praxisregel: Netto-Datenrate liegt oft 10–20% unter der Brutto-Angabe (Overhead, Retransmits, etc.).",
      "correctForms": [
        "datenrate"
      ]
    },
    {
      "id": "card_014",
      "text": "Kapazität = n · Größe, keine Redundanz, maximale Kapazität.",
      "correctForms": [
        "raid_0"
      ]
    },
    {
      "id": "card_015",
      "text": "Kapazität = (n/2) · Größe, Spiegelung, halbe Kapazität bei Paaren.",
      "correctForms": [
        "raid_1"
      ]
    },
    {
      "id": "card_016",
      "text": "Kapazität = (n−1) · Größe, eine Platte für Parität.",
      "correctForms": [
        "raid_5"
      ]
    },
    {
      "id": "card_017",
      "text": "Kapazität = (n−2) · Größe, zwei Platten für Parität.",
      "correctForms": [
        "raid_6"
      ]
    },
    {
      "id": "card_018",
      "text": "Formel: Hosts = 2^(32−Prefix) − 2 (klassische Regel ohne Sonderfälle).",
      "correctForms": [
        "hosts_pro_subnetz"
      ]
    },
    {
      "id": "card_019",
      "text": "Identifiziert das Subnetz (die „erste“ Adresse des Netzes).",
      "correctForms": [
        "netzadresse"
      ]
    },
    {
      "id": "card_020",
      "text": "Letzte Adresse im Subnetz (klassisch nicht als Host nutzbar).",
      "correctForms": [
        "broadcast_adresse"
      ]
    },
    {
      "id": "card_021",
      "text": "Formel: Pixel = Breite · Höhe (z. B. 1920×1080).",
      "correctForms": [
        "pixelanzahl"
      ]
    },
    {
      "id": "card_022",
      "text": "24 bit bedeutet typischerweise 8 bit pro Kanal (RGB).",
      "correctForms": [
        "farbtiefe"
      ]
    },
    {
      "id": "card_023",
      "text": "„Doppelte Auflösung“ in Breite und Höhe führt zu vierfacher Pixelanzahl.",
      "correctForms": [
        "pixelanzahl"
      ]
    },
    {
      "id": "card_024",
      "text": "Codierung für Texttransport; macht Daten typischerweise um etwa ein Drittel größer.",
      "correctForms": [
        "base64_overhead"
      ]
    },
    {
      "id": "card_025",
      "text": "Base64 ist Verschlüsselung und schützt Inhalte.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_026",
      "text": "Ausfallzeit = Zeitraum · (1 − Verfügbarkeit).",
      "correctForms": [
        "ausfallzeit"
      ]
    },
    {
      "id": "card_027",
      "text": "„Drei Neun“ (99,9%) pro Monat bedeuten ungefähr unter einer Stunde Ausfallzeit bei 30 Tagen.",
      "correctForms": [
        "verfugbarkeit"
      ]
    },
    {
      "id": "card_028",
      "text": "Formel: Energie (Wh) = Leistung (W) · Zeit (h).",
      "correctForms": [
        "energie_wh"
      ]
    },
    {
      "id": "card_029",
      "text": "Formel: Laufzeit (h) = Wh / W (real meist kürzer durch Verluste/Alterung).",
      "correctForms": [
        "laufzeit_usv"
      ]
    },
    {
      "id": "card_030",
      "text": "Strategie: Erst Größenordnung abschätzen und Einheiten prüfen, dann exakte Rechnung – Realismuscheck inklusive.",
      "correctForms": [
        "uberschlag_plausibilitatscheck"
      ]
    },
    {
      "id": "card_031",
      "text": "Goldene Regel: Nicht zu früh runden – erst am Ende runden, sonst summieren sich Fehler.",
      "correctForms": [
        "rundungsregel"
      ]
    }
  ]
}
