  "cards": [
    {
      "id": "card_001",
      "text": "Zielt primär auf schnelle Wiederherstellung nach Vorfall.",
      "correctForms": [
        "backup"
      ]
    },
    {
      "id": "card_002",
      "text": "Zielt primär auf langfristige, nachweisbare Aufbewahrung.",
      "correctForms": [
        "archivierung"
      ]
    },
    {
      "id": "card_003",
      "text": "Beschreibt die maximal tolerierbare Wiederanlaufzeit eines Services.",
      "correctForms": [
        "rto"
      ]
    },
    {
      "id": "card_004",
      "text": "Beschreibt den maximal tolerierbaren Datenverlust in Zeit.",
      "correctForms": [
        "rpo"
      ]
    },
    {
      "id": "card_005",
      "text": "Write Once Read Many: Nach Speicherung nicht überschreibbar.",
      "correctForms": [
        "worm"
      ]
    },
    {
      "id": "card_006",
      "text": "Regelt, wie lange welche Dokumentklasse aufzubewahren ist.",
      "correctForms": [
        "retention_policy"
      ]
    },
    {
      "id": "card_007",
      "text": "Temporäre Sperre gegen Löschung wegen Rechts-/Prüfungsverfahren.",
      "correctForms": [
        "legal_hold"
      ]
    },
    {
      "id": "card_008",
      "text": "Strukturinformationen wie Dokumenttyp, Datum, Kunde für Suche und Regeln.",
      "correctForms": [
        "metadaten"
      ]
    },
    {
      "id": "card_009",
      "text": "Ermöglicht Suche über Textinhalt statt nur Dateiname.",
      "correctForms": [
        "volltextindex"
      ]
    },
    {
      "id": "card_010",
      "text": "Protokolliert nachvollziehbar, wer wann welche Aktion ausgeführt hat.",
      "correctForms": [
        "audit_trail"
      ]
    },
    {
      "id": "card_011",
      "text": "Anforderung, dass archivierte Inhalte nicht unkontrolliert veränderbar sind.",
      "correctForms": [
        "unveranderbarkeit"
      ]
    },
    {
      "id": "card_012",
      "text": "Stellt sicher, dass Daten korrekt und unverfälscht bleiben.",
      "correctForms": [
        "datenintegritat"
      ]
    },
    {
      "id": "card_013",
      "text": "Schützt Inhalte vor unbefugtem Mitlesen auf Speichermedien.",
      "correctForms": [
        "verschlusselung"
      ]
    },
    {
      "id": "card_014",
      "text": "Legt fest, welche Rollen lesen/schreiben/exportieren dürfen.",
      "correctForms": [
        "zugriffskontrolle"
      ]
    },
    {
      "id": "card_015",
      "text": "Ordnet eingehende Dokumente Kategorien mit passenden Regeln zu.",
      "correctForms": [
        "dokumentklassifikation"
      ]
    },
    {
      "id": "card_016",
      "text": "Steuert den Datenlebenszyklus von Entstehung bis Löschung.",
      "correctForms": [
        "ilm"
      ]
    },
    {
      "id": "card_017",
      "text": "Praktischer Nachweis, dass Wiederherstellung im Ernstfall funktioniert.",
      "correctForms": [
        "restore_test"
      ]
    },
    {
      "id": "card_018",
      "text": "Umfasst Planung und Abläufe für Wiederanlauf nach großem Ausfall.",
      "correctForms": [
        "disaster_recovery"
      ]
    },
    {
      "id": "card_019",
      "text": "Hält mehrere Stände vor, um auf frühere Zustände zurückzugehen.",
      "correctForms": [
        "versionierung"
      ]
    },
    {
      "id": "card_020",
      "text": "Punkt-in-Zeit-Abbild eines Systems oder Volumes.",
      "correctForms": [
        "snapshot"
      ]
    },
    {
      "id": "card_021",
      "text": "Sichert nur Änderungen seit der letzten Sicherung.",
      "correctForms": [
        "inkrementelles_backup"
      ]
    },
    {
      "id": "card_022",
      "text": "Erzeugt eine vollständige Sicherung des gesamten Datenbestands.",
      "correctForms": [
        "vollsicherung"
      ]
    },
    {
      "id": "card_023",
      "text": "Eliminiert redundante Datenblöcke zur Speicherreduktion.",
      "correctForms": [
        "deduplizierung"
      ]
    },
    {
      "id": "card_024",
      "text": "Gibt den Zeitraum vor, in dem ein Dokument verfügbar sein muss.",
      "correctForms": [
        "aufbewahrungsfrist"
      ]
    },
    {
      "id": "card_025",
      "text": "Dokumentierte Entfernung nach Ablauf der Frist nach definierten Regeln.",
      "correctForms": [
        "rechtskonforme_loschung"
      ]
    },
    {
      "id": "card_026",
      "text": "Sicherstellung, dass ein bestimmtes Archivdokument schnell gefunden werden kann.",
      "correctForms": [
        "retrieval_fahigkeit"
      ]
    },
    {
      "id": "card_027",
      "text": "Nachweischarakter eines archivierten Dokuments in Prüfung/Rechtsfall.",
      "correctForms": [
        "beweiswert"
      ]
    },
    {
      "id": "card_028",
      "text": "Kombiniert operative Wiederherstellung und langfristige Nachweisführung.",
      "correctForms": [
        "hybridkonzept_backup_archiv"
      ]
    },
    {
      "id": "card_029",
      "text": "RTO und RPO gehören in den Kern eines Backup-Konzepts.",
      "correctForms": [
        "backup"
      ]
    },
    {
      "id": "card_030",
      "text": "WORM und Retention-Regeln sind zentrale Bausteine revisionsnaher Archivierung.",
      "correctForms": [
        "archivierung"
      ]
    },
    {
      "id": "card_031",
      "text": "Wenn die Löschfrist pausieren muss, weil ein Verfahren läuft, spricht man von ...",
      "correctForms": [
        "legal_hold"
      ]
    },
    {
      "id": "card_032",
      "text": "Erhöht meist die Auffindbarkeit, aber nicht automatisch die Integrität.",
      "correctForms": [
        "volltextindex"
      ]
    },
    {
      "id": "card_033",
      "text": "Backups ohne Restore-Test sind ein hohes Risiko.",
      "correctForms": [
        "restore_test"
      ]
    },
    {
      "id": "card_034",
      "text": "Ist typischerweise für schnelle Rollbacks im Betrieb sehr nützlich.",
      "correctForms": [
        "snapshot"
      ]
    },
    {
      "id": "card_035",
      "text": "Kann Aufbewahrungspflichten allein nicht ersetzen: rein operative Datensicherung.",
      "correctForms": [
        "backup"
      ]
    },
    {
      "id": "card_036",
      "text": "Ist zentral, wenn Prüfer nachvollziehbare Zugriffshistorien erwarten.",
      "correctForms": [
        "audit_trail"
      ]
    },
    {
      "id": "card_037",
      "text": "Ohne diese Struktur werden Fristen- und Suchregeln oft unzuverlässig.",
      "correctForms": [
        "metadaten"
      ]
    },
    {
      "id": "card_038",
      "text": "Diese Kennzahl beantwortet: Wie lange darf die Anwendung ausfallen?",
      "correctForms": [
        "rto"
      ]
    },
    {
      "id": "card_039",
      "text": "Diese Kennzahl beantwortet: Wie weit darf der Datenstand zurückliegen?",
      "correctForms": [
        "rpo"
      ]
    },
    {
      "id": "card_040",
      "text": "Verschlüsselung, Zugriffskontrolle und Integritätsschutz sind für vertrauenswürdige Ablage relevant.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_041",
      "text": "'Ein täglicher Snapshot erfüllt automatisch sämtliche Compliance-Anforderungen eines Archivs.'",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
