  "cards": [
    {
      "id": "card_001",
      "text": "Backup dient der kurzfristigen Wiederherstellung nach Fehler, Malware, Löschen oder Desaster.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Backup ist typischerweise überschreibbar und rotiert (z. B. tägliche Stände), weil es auf Restore-Zeitpunkte optimiert ist.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Archiv dient der langfristigen Aufbewahrung (z. B. Belege/Compliance) und ist nicht primär für schnelle System-Restores gedacht.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Archivdaten sollen nachträglich nicht (oder nur nachvollziehbar) veränderbar sein – je nach Anforderung WORM/Immutability.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Prüfungsfalle: „Ich hab ein Backup, also bin ich compliant“ – nein, Aufbewahrungsfristen und Unveränderbarkeit sind Archiv-Themen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Archiv braucht meist Suchbarkeit (Index/Metadaten), damit man einzelne Dokumente schnell finden und nachweisen kann.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Archiv kann Retention-Regeln haben (Aufbewahren bis Datum X) und danach geregelte Löschung – abhängig von Vorgaben.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Backup-Restore zielt oft auf „System wieder lauffähig“ oder „Datenstand von gestern“ – nicht auf Beleg-Nachweis über Jahre.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Archiv zielt oft auf „Nachweisbarkeit“: Wer hat was wann abgelegt, unverändert, auffindbar, revisionssicher (wenn gefordert).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Prüfungsfalle: Wenn Archivdaten beliebig überschrieben werden können, ist das häufig kein echtes Archiv im Compliance-Sinn.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "„Archiv = kurzfristige Wiederherstellung nach Ransomware, Hauptziel ist schnelles Restore.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "„Backup = langfristige, unveränderliche Aufbewahrung von Belegen über viele Jahre.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Backup und Archiv sind unterschiedliche Zwecke: Restore nach Zwischenfällen vs. langfristige, ggf. unveränderliche Aufbewahrung mit Suchbarkeit.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
