        "alle"
      ]
    },
    {
      "id": "card_037",
      "text": "RAID 0 bietet die hoechste Datensicherheit.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_038",
      "text": "Snapshots koennen sinnvoll sein, ersetzen aber keine externe Datensicherung.",
