  "cards": [
    {
      "id": "card_001",
      "text": "Infrastruktur mieten: VMs, Storage und Netzwerk – du verwaltest Betriebssystem, Updates und deine Anwendungen selbst.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Typisch für IaaS: Du entscheidest über OS-Version, Installationen, Patches und Konfiguration (mehr Kontrolle, mehr Betrieb).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Prüfungsfalle: Auch bei IaaS bleiben Sicherheitsaufgaben beim Kunden (z. B. OS-Hardening, Accounts, App-Security).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Plattform mieten: Runtime/DB/Managed Services – du betreibst weniger selbst, hast aber weniger Kontrolle über die Umgebung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Typisch für PaaS: Du lieferst Code/Config, die Plattform übernimmt viele Betriebsaufgaben wie Skalierung oder Patchen der Runtime.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "PaaS eignet sich oft für schnelles Entwickeln/Deployen, wenn du Standard-Stacks nutzt und weniger OS-Kontrolle brauchst.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Prüfungsfalle: PaaS kann zu Anbieterabhängigkeit (Lock-in) führen, wenn Services sehr spezifisch sind.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Fertige Anwendung nutzen: Du konfigurierst nur noch Nutzer/Settings – Betrieb und Updates macht der Anbieter.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Typisch für SaaS: Schnell startklar, geringster Betriebsaufwand, aber auch geringste Kontrolle über technische Details.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Prüfungsfalle: Bei SaaS hast du meist kaum Einfluss auf Update-Zeitpunkt/Versionen – das ist Anbieter-Entscheidung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Kontrollgrad steigt typischerweise von SaaS → PaaS → IaaS, während Betriebsaufwand in die andere Richtung steigt.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "„Bei SaaS verwaltest du das Betriebssystem selbst und installierst Patches auf der VM.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "„Bei PaaS mietest du nur virtuelle Hardware und musst OS + Runtime komplett selbst betreiben.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "IaaS/PaaS/SaaS unterscheiden sich im Kern daran, wie viel Betrieb du selbst machst und wie viel Kontrolle du über OS/Plattform hast.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
