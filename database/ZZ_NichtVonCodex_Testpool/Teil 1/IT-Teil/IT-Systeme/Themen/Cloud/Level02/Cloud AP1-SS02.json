  "cards": [
    {
      "id": "card_001",
      "text": "Du betreibst VMs selbst und patchst das Gastbetriebssystem eigenverantwortlich.",
      "correctForms": [
        "iaas"
      ]
    },
    {
      "id": "card_002",
      "text": "Du deployst nur den Anwendungscode; Laufzeit und Plattformbetrieb liefert der Anbieter.",
      "correctForms": [
        "paas"
      ]
    },
    {
      "id": "card_003",
      "text": "Fertige Business-Anwendung im Browser als Abomodell nutzen.",
      "correctForms": [
        "saas"
      ]
    },
    {
      "id": "card_004",
      "text": "Geteilte Provider-Infrastruktur, nutzungsbasierte Abrechnung, Ressourcen extern bezogen.",
      "correctForms": [
        "public_cloud"
      ]
    },
    {
      "id": "card_005",
      "text": "Cloud-Prinzipien auf dedizierter Infrastruktur fuer genau eine Organisation.",
      "correctForms": [
        "private_cloud"
      ]
    },
    {
      "id": "card_006",
      "text": "Regulierte Kernsysteme bleiben on-prem, Lastspitzen gehen in externe Cloud-Ressourcen.",
      "correctForms": [
        "hybrid_cloud"
      ]
    },
    {
      "id": "card_007",
      "text": "Zwei Public-Provider gezielt fuer Risiko- und Funktionsdiversifizierung einsetzen.",
      "correctForms": [
        "multi_cloud"
      ]
    },
    {
      "id": "card_008",
      "text": "Grundprinzip: Anbieter schuetzt die Cloud, Kunde schuetzt Konfiguration, Zugriffe und Daten.",
      "correctForms": [
        "shared_responsibility"
      ]
    },
    {
      "id": "card_009",
      "text": "Physische Sicherheit im Rechenzentrum, Host-Hardware und Basisschichten absichern.",
      "correctForms": [
        "providerverantwortung"
      ]
    },
    {
      "id": "card_010",
      "text": "Rollenmodell, Rechte, Netzsegmentierung, Datenklassifizierung und Backup-Strategie festlegen.",
      "correctForms": [
        "kundenverantwortung"
      ]
    },
    {
      "id": "card_011",
      "text": "Berechtigungen nur so weit vergeben, wie fuer den Zweck zwingend noetig.",
      "correctForms": [
        "iam_least_privilege"
      ]
    },
    {
      "id": "card_012",
      "text": "Admin-Login erfordert zusaetzlichen Besitzfaktor neben Passwort.",
      "correctForms": [
        "mfa"
      ]
    },
    {
      "id": "card_013",
      "text": "CI/CD blockiert Deployments, wenn Regeln wie \"kein oeffentlicher Bucket\" verletzt werden.",
      "correctForms": [
        "policy_as_code"
      ]
    },
    {
      "id": "card_014",
      "text": "Typische Ursache von Cloud-Vorfaellen: offene Ports, zu breite Rollen, falsch gesetzte ACLs.",
      "correctForms": [
        "fehlkonfiguration"
      ]
    },
    {
      "id": "card_015",
      "text": "Proprietaere APIs erschweren spaeteren Plattformwechsel technisch und wirtschaftlich.",
      "correctForms": [
        "vendor_lock_in"
      ]
    },
    {
      "id": "card_016",
      "text": "Architektur mit offenen Standards, exportierbaren Datenformaten und klarer Exit-Option.",
      "correctForms": [
        "portabilitaetsstrategie"
      ]
    },
    {
      "id": "card_017",
      "text": "Kontinuierliche Kostensteuerung mit Verantwortlichkeit von Technik und Fachbereich.",
      "correctForms": [
        "finops"
      ]
    },
    {
      "id": "card_018",
      "text": "Ressourcen verpflichtend Teams/Services/Kostenstellen zuordnen.",
      "correctForms": [
        "kosten_tagging"
      ]
    },
    {
      "id": "card_019",
      "text": "Warnschwellen bei 80/95 Prozent Budgetverbrauch mit Eskalationspfad.",
      "correctForms": [
        "budget_alarm"
      ]
    },
    {
      "id": "card_020",
      "text": "Instanzgroessen auf Basis realer Lastdaten systematisch anpassen.",
      "correctForms": [
        "rightsizing"
      ]
    },
    {
      "id": "card_021",
      "text": "Kapazitaet dynamisch anhand von Metriken hoch- und herunterfahren.",
      "correctForms": [
        "auto_scaling"
      ]
    },
    {
      "id": "card_022",
      "text": "Steuert den geographischen Speicherort personenbezogener Daten gemaess Vorgaben.",
      "correctForms": [
        "data_residency"
      ]
    },
    {
      "id": "card_023",
      "text": "Vertragliche und organisatorische Datenschutzmassnahmen dokumentieren und pruefbar halten.",
      "correctForms": [
        "avv_toms"
      ]
    },
    {
      "id": "card_024",
      "text": "Schuetzt Daten bei Speicherung und Transport plus kontrolliertes Schluesselmanagement.",
      "correctForms": [
        "verschluesselung_kms"
      ]
    },
    {
      "id": "card_025",
      "text": "Protokolliert nachvollziehbar, wer welche sicherheitsrelevante Aenderung wann ausfuehrte.",
      "correctForms": [
        "audit_logging"
      ]
    },
    {
      "id": "card_026",
      "text": "Korrelierte Auswertung von Cloud-Events fuer fruehe Angriffserkennung.",
      "correctForms": [
        "siem"
      ]
    },
    {
      "id": "card_027",
      "text": "Dienste ueber mehrere Verfuegbarkeitszonen verteilen, um Zonen-Ausfaelle abzufangen.",
      "correctForms": [
        "multi_az"
      ]
    },
    {
      "id": "card_028",
      "text": "Wiederanlauf in zweiter Region nach definierten Schwellwerten und Runbook.",
      "correctForms": [
        "multi_region_dr"
      ]
    },
    {
      "id": "card_029",
      "text": "Definiert maximal zulaessige Wiederanlaufzeit eines Services.",
      "correctForms": [
        "rto"
      ]
    },
    {
      "id": "card_030",
      "text": "Definiert maximal tolerierbaren Datenverlust bis zum letzten konsistenten Stand.",
      "correctForms": [
        "rpo"
      ]
    },
    {
      "id": "card_031",
      "text": "Eine Sicherung gilt erst dann als belastbar, wenn Wiederherstellung regelmaessig geuebt wird.",
      "correctForms": [
        "backup_restore_test"
      ]
    },
    {
      "id": "card_032",
      "text": "Metriken, Logs und Traces gemeinsam nutzen, um Engpaesse und Stoerungen sauber zu analysieren.",
      "correctForms": [
        "observability"
      ]
    },
    {
      "id": "card_033",
      "text": "Definierter Ausstiegspfad mit Datenexport, Verantwortlichkeiten und Downtime-Plan.",
      "correctForms": [
        "exit_strategie"
      ]
    },
    {
      "id": "card_034",
      "text": "Cloud ist automatisch billiger, automatisch sicher und automatisch compliant.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_035",
      "text": "Ohne Governance koennen in der Cloud gleichzeitig Sicherheits-, Compliance- und Kostenprobleme entstehen.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
