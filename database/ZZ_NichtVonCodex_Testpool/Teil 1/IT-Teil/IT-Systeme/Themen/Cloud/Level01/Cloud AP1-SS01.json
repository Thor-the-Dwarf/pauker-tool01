  "cards": [
    {
      "id": "card_001",
      "text": "Vorteil: Ressourcen lassen sich schnell hoch- und runter skalieren, ohne neue Hardware zu kaufen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Vorteil: Schnelle Bereitstellung – neue Systeme/Services können in Minuten statt Tagen/Wochen stehen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Vorteil: OPEX statt CAPEX – laufende Betriebskosten statt hoher Einmalinvestitionen für Hardware.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Vorteil: Verfügbarkeit kann über Zonen/Regionen-Optionen erhöht werden (wenn korrekt geplant und gebucht).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Risiko: Vendor Lock-in – Wechsel wird teuer/aufwendig durch proprietäre Dienste, APIs oder Datenformate.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Risiko: Kostenexplosion durch falsches Sizing, Dauerbetrieb, Datenverkehr, fehlende Limits oder „vergessene“ Ressourcen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Risiko: Datenstandort/Compliance – rechtliche Vorgaben (z. B. Aufbewahrung, DSGVO, Branchenregeln) müssen erfüllt sein.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Risiko: Fehlkonfiguration ist ein Klassiker (z. B. öffentliche Buckets, zu breite Rollen/Rechte, offene Ports).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Prüfungsfalle: Cloud ist nicht automatisch sicher – Sicherheit hängt stark von Konfiguration, Rechten und Prozessen ab.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Shared Responsibility: Provider sichert die „Cloud“ (z. B. Rechenzentrum, Host-Infrastruktur, Basisschichten).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Shared Responsibility: Kunde sichert Konfiguration, Daten und Zugriffe (z. B. IAM/Rollen, Passwörter, MFA, Policies).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "Prüfungsfalle: „Der Provider macht Backups automatisch“ stimmt nur, wenn der Service/Plan das vorsieht und du es aktiv konfigurierst.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Prüfungsfalle: Ein öffentlich erreichbarer Dienst ist nicht automatisch ein Fehler – aber er braucht Absicherung (Auth, Firewall, Logging, Updates).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "Kostenkontrolle in der Cloud heißt typischerweise: Budgets/Alarme, Tags, Limits/Quotas, Abschaltregeln und Monitoring.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "„Shared Responsibility bedeutet: Der Provider ist für alles verantwortlich, inklusive deiner Nutzerrechte und Daten.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_016",
      "text": "Cloud-Vorteile, -Risiken und Shared Responsibility gehören zusammen: schnell & skalierbar, aber nur sicher und bezahlbar mit sauberer Konfiguration und Governance.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
