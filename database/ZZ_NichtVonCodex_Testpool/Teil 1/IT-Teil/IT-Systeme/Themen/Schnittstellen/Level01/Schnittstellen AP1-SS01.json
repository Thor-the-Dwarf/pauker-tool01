  "cards": [
    {
      "id": "card_001",
      "text": "PCIe-Lanes sind begrenzt: Viele schnelle Karten (GPU/NIC/SSD) teilen sich Bandbreite oder Slots laufen langsamer als gedacht.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Prüfungsfalle: Ein physischer x16-Slot ist nicht automatisch elektrisch x16 angebunden.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Wenn ein zusätzlicher PCIe-Slot belegt wird, kann ein anderer Slot auf x8/x4 herunterfallen (Lane-Sharing).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "CPU-PCIe vs Chipsatz-PCIe: Geräte am Chipsatz teilen sich typischerweise einen Uplink zur CPU (Bottleneck möglich).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "M.2 ist ein Steckplatz-Formfaktor: Dort kann eine NVMe-SSD oder eine SATA-SSD stecken (nicht immer NVMe).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Typischer Stolperstein: Ein belegter M.2-Slot kann bestimmte SATA-Ports deaktivieren (steht im Mainboard-Handbuch).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Nicht jeder M.2-Slot unterstützt jede Länge (z. B. 2280/22110) und jede Betriebsart (NVMe/SATA).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Prüfungsfalle: „M.2 = immer schneller als SATA“ stimmt nicht, wenn im Slot nur SATA oder reduzierte PCIe-Anbindung möglich ist.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "USB-C beschreibt nur die Steckerform, nicht automatisch USB-Geschwindigkeit oder Video-Fähigkeit.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "USB-Standards sind verwirrend (Gen-Bezeichnungen): Entscheidend sind echte Datenrate und unterstützte Features des Ports/Kabels.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Ein langsames oder ungeeignetes Kabel kann hohe USB-Datenraten verhindern, obwohl Port und Gerät es könnten.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "DisplayPort und HDMI haben Versionen/Features: Nicht jedes Kabel/Port unterstützt hohe Auflösung/Hz oder bestimmte Features.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Prüfungsfalle: Monitor kann 4K@60, aber falscher Port/Adapter/Kabel führt zu 4K@30 oder geringerer Auflösung.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "Netzwerk: 1G/2.5G/10G müssen auf beiden Seiten unterstützt werden (NIC + Switch/Router) und korrekt aushandeln.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "Prüfungsfalle: 2.5G-NIC bringt nichts, wenn Switch/Port nur 1G kann oder Autonegotiation falsch läuft.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_016",
      "text": "Treiber beeinflussen Stabilität und Leistung: Falscher/alter Treiber kann zu Drops, Bluescreens oder fehlenden Features führen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_017",
      "text": "Firmware-Updates (z. B. SSD/NIC) können Bugs beheben und Features freischalten – aber auch Risiken haben.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_018",
      "text": "BIOS/UEFI-Updates sind oft nötig für CPU-/RAM-Kompatibilität, Stabilität und Sicherheitsfixes.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_019",
      "text": "Prüfungsfalle: Neues CPU-Modell passt mechanisch in den Sockel, läuft aber ohne BIOS-Update ggf. gar nicht.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_020",
      "text": "Viele Features hängen an BIOS/UEFI-Settings (z. B. Secure Boot, Virtualisierung, PCIe-Gen, Boot-Modus) und wirken wie „Hardware-Defekt“, wenn falsch gesetzt.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_021",
      "text": "Schnittstellen, Bandbreite, Ports sowie Treiber/Firmware/BIOS sind die klassischen Kompatibilitäts-Stolpersteine im Hardware-Alltag.",
      "correctForms": [
        "alle"
      ]
    },
    {
      "id": "card_022",
      "text": "„Wenn es mechanisch passt, ist es immer kompatibel und läuft ohne Treiber oder Firmware stabil.“",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
