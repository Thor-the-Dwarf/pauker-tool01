  "cards": [
    {
      "id": "card_001",
      "text": "CPU-Leistung ist kontextabhängig: UI/Office profitiert oft stärker von Single-Core-Leistung als von vielen Kernen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Multi-Core-Leistung ist besonders wichtig für parallelisierbare Lasten wie VMs, Rendering oder große Builds.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "Prüfungsfalle: „Mehr GHz = immer schneller“ stimmt nicht zwangsläufig (IPC, Cache, Architektur und Last zählen mit).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "Boost-Takt gilt oft nur kurz oder für wenige Kerne; unter Dauerlast kann der Takt sinken.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "Thermal Throttling: Wenn die CPU zu heiß wird, reduziert sie Takt/Spannung → Leistung fällt spürbar.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Cache hilft, RAM-Zugriffe zu vermeiden: Mehr/effizienter Cache kann reale Performance stark verbessern.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Viele Hintergrundprozesse + schwacher Single-Core können ein System „laggy“ wirken lassen, obwohl die CPU-Auslastung nicht 100% ist.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Zu wenig RAM führt zu Paging/Swap: Daten werden auf SSD/HDD ausgelagert → das System wird „zäh“.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Paging/Swap ist um Größenordnungen langsamer als RAM, weil Massenspeicher viel höhere Latenzen hat.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Mehr RAM-Kapazität bringt oft mehr als minimal höherer RAM-Takt, wenn vorher ständig ausgelagert wurde.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "RAM-Takt beeinflusst Bandbreite; Latenz/Timings beeinflussen, wie schnell einzelne Zugriffe starten können.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "CL/Timings sind keine alleinige Wahrheit: Effektive Latenz hängt auch vom Takt ab (schnellere MHz können trotz höherem CL schneller sein).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "Dual-Channel kann die Speicherbandbreite erhöhen (passende Module und richtige Slot-Paarung nötig).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "Kompatibilität: RAM muss zu Mainboard/CPU-Generation passen (DDR-Generation, unterstützte Profile, Slots/Max-Kapazität).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_015",
      "text": "XMP/EXPO sind Profile für höhere RAM-Taktraten/Timings; ohne Aktivierung läuft RAM oft mit Standardwerten.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_016",
      "text": "ECC-RAM: Erkennt (und i. d. R. korrigiert) Speicherfehler, wichtig in Servern für Stabilität/Datenintegrität.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_017",
      "text": "ECC ist nicht automatisch überall nutzbar: Board/CPU müssen ECC unterstützen (sonst läuft es ggf. ohne ECC-Funktion oder gar nicht).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_018",
      "text": "Prüfungsfalle: „Swap ist ein Ersatz für RAM“ – nein, es ist nur ein Notbehelf und kostet massiv Performance.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_019",
      "text": "Wenn ein System beim Programmwechsel ruckelt und die SSD dauerhaft arbeitet, ist das ein typisches Indiz für RAM-Paging.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_020",
      "text": "„RAM ist dauerhaft wie SSD und behält Inhalte nach dem Ausschalten“.",
      "correctForms": [
        "keine"
      ]
    }
  ]
}
