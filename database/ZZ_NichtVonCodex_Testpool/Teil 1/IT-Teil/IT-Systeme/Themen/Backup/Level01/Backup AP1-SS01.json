  "cards": [
    {
      "id": "card_001",
      "text": "Backup-Ziel: Daten und Systeme nach Fehlern, Malware/Ransomware, versehentlichem Löschen oder Hardware-Defekt wiederherstellen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_002",
      "text": "Prüfungsfalle: Backup ist nicht gleich Hochverfügbarkeit – ein Backup hilft beim Restore, nicht beim nahtlosen Weiterbetrieb.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_003",
      "text": "3-2-1-Regel: Insgesamt 3 Kopien der Daten (Original + 2 Backups).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_004",
      "text": "3-2-1-Regel: 2 unterschiedliche Medien/Technologien nutzen (z. B. NAS + Tape/Cloud), um gemeinsame Ausfälle zu vermeiden.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_005",
      "text": "3-2-1-Regel: 1 Kopie extern/offsite lagern (z. B. anderes Gebäude/Cloud), damit Brand/Diebstahl nicht alles zerstört.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_006",
      "text": "Vollbackup: Sichert alle ausgewählten Daten komplett – einfaches Restore, aber mehr Zeit und Speicherbedarf.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_007",
      "text": "Inkrementell: Sichert nur Änderungen seit dem letzten Backup (egal ob voll oder inkrementell) – schnell, aber Restore braucht die Kette.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_008",
      "text": "Differentiell: Sichert alle Änderungen seit dem letzten Vollbackup – wächst täglich an, Restore braucht Voll + letztes Differential.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_009",
      "text": "Prüfungsfalle: Inkrementell und differentiell werden oft verwechselt – entscheidend ist, worauf „seit wann“ sich die Änderungen beziehen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_010",
      "text": "Restore-Realität: Backups sind wertlos, wenn Wiederherstellung nie getestet wird (Stichwort Restore-Test).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_011",
      "text": "Ransomware-Schutz: Mindestens eine Kopie sollte vor Überschreiben/Manipulation geschützt sein (z. B. offline/immutable).",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_012",
      "text": "Typischer Stolperstein: Wenn Backup und Produktivdaten im selben System ohne Trennung liegen, kann ein Angriff beides treffen.",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_013",
      "text": "„Ein Backup verhindert, dass Daten verloren gehen, selbst wenn man nichts wiederherstellen muss.“",
      "correctForms": [
        "keine"
      ]
    },
    {
      "id": "card_014",
      "text": "Backup-Grundprinzipien (Ziel, 3-2-1, Voll/inkrementell/differentiell) sind Basiswissen und tauchen in vielen AP1-Szenarien auf.",
      "correctForms": [
        "alle"
      ]
    }
  ]
}
